#!/usr/bin/env bash
set -euo pipefail
# ============================================================================
# lint - shellcheck every bash script in the package.
#
# Check the CLI, hooks, and tests. Files without Bash shebangs, including zsh
# configuration, are skipped. Run behavioral tests with test/run.
#
# Discovers targets by shebang (every tracked file whose first line names bash),
# so a new hook is linted automatically with no list to maintain. Runs from
# anywhere, since it resolves the package root from its own location.
#
# Needs `shellcheck` on PATH; if it's absent but docker is, it falls back to the
# pinned koalaman/shellcheck image.
#   Usage: bin/lint
# ============================================================================

SHELLCHECK_IMAGE="koalaman/shellcheck:v0.10.0"

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

# Include tracked and untracked files, excluding ignored build output and
# dependencies. Use an array without mapfile for Bash 3.2 compatibility.
files=()
while IFS= read -r f; do
  # tr: a binary file's first "line" holds NULs, which bash warns about
  case "$(head -n1 "$f" 2>/dev/null | tr -d '\0')" in
    '#!'*bash*) files+=("$f") ;;
  esac
done < <(git ls-files --cached --others --exclude-standard | sort)

[ "${#files[@]}" -gt 0 ] || { echo "lint: no bash scripts found" >&2; exit 1; }

# -x: follow `source`d files (so each hook's `helpers` is checked too).
if command -v shellcheck >/dev/null 2>&1; then
  echo "==> shellcheck ${files[*]}" >&2
  exec shellcheck -x "${files[@]}"
elif command -v docker >/dev/null 2>&1; then
  echo "==> shellcheck not found, using docker ($SHELLCHECK_IMAGE)" >&2
  exec docker run --rm -v "$root:/mnt" -w /mnt "$SHELLCHECK_IMAGE" -x "${files[@]}"
else
  echo "lint: need 'shellcheck' (or 'docker' for the pinned image) on PATH" >&2
  exit 1
fi
