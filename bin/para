#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# para — parallel dev workspaces on Incus.
#
# Each workspace is an unprivileged Incus container with its own clone, its own
# stack, a static bridge IP, and an https:// URL served by a para-owned Caddy.
#
# This file is the generic mechanism and nothing else: everything a project
# needs done lives in that project's .paraspace/ dir (Parafile, hooks/,
# commands/), which para runs but never contains.
#
# The prose lives in docs/ — parafile.md, hooks.md, commands.md, image.md,
# urls.md, how-it-works.md, versioning.md. It is not restated here.
# ============================================================================

CT_PREFIX=para-

# The oldest incus para is known to work with. It reads every workspace out of
# incus in one query, using config keys and device keys as `incus list` columns;
# an incus too old for that rejects the column outright. Ubuntu's apt repos
# still ship 6.2, which is too old.
MIN_INCUS=6.22

# The columns every workspace reader below expects, in order. Routes go LAST:
# they are space-separated by construction, but a stamp left by an older para
# may hold commas, and `read` puts whatever remains of the line in the final
# field — so a legacy value arrives intact instead of shifting the others.
WS_COLS='n,s,user.para.project,user.para.domain,devices:eth0.ipv4.address,user.para.routes'

# Prefixed to every command para runs inside a workspace. Everything the guest
# needs is already in the guest, so nothing is spliced in from the host except
# the caller's own command, appended verbatim.
# shellcheck disable=SC2016  # the guest expands these, not us
GUEST_PRELUDE='
  [ -f ~/.paraspace/env ] && . ~/.paraspace/env
  infocmp "${TERM:-}" >/dev/null 2>&1 || export TERM=xterm-256color
  cd "$HOME/${PARA_CLONE_DIR:-}" 2>/dev/null || cd "$HOME"
'

# ---- output ----------------------------------------------------------------
log()  { printf '\033[36m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[33mwarn:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }

# A human on both ends? PARA_NONINTERACTIVE=1 forces the scripted path.
interactive() { [ -z "${PARA_NONINTERACTIVE:-}" ] && [ -t 0 ] && [ -t 1 ]; }

# ---- configuration ---------------------------------------------------------
# Two sourced bash files, one idiom:
#
#   : "${PARA_X:=value}"   yields to the environment
#   PARA_X=value           insists
#
# so precedence is environment > user config > Parafile > the defaults at the
# bottom of load_config. Nothing below implements that; bash does.
load_config() {
  PARA_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/para"
  PARA_CONFIG="$PARA_CONFIG_DIR/config"
  PARA_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/para"
  CADDYFILE="$PARA_STATE_DIR/Caddyfile"
  CADDY_PID="$PARA_STATE_DIR/caddy.pid"
  # shellcheck disable=SC2034  # read by para_env's ${!PARA_@}, so a project
  # command can call back into para without relying on $PATH.
  PARA_BIN="$(cd "$(dirname "$0")" && pwd)/${0##*/}"

  # The project para operates on: the nearest .paraspace/ from $PWD upward,
  # like git and compose find theirs. Only a file locator — a project's
  # identity is PARA_PROJECT, so moving the checkout never orphans a workspace.
  PARA_PROJECT_DIR="${PARA_PROJECT_DIR:-$(find_project_root || true)}"
  # shellcheck source=/dev/null  # a per-user and a per-project file, both runtime
  if [ -f "$PARA_CONFIG" ]; then . "$PARA_CONFIG"; fi
  # shellcheck source=/dev/null
  if [ -f "$PARA_PROJECT_DIR/.paraspace/Parafile" ]; then . "$PARA_PROJECT_DIR/.paraspace/Parafile"; fi

  : "${PARA_DOMAIN:=paraspace.dev}"
  : "${PARA_HTTPS_PORT:=8443}"
  : "${PARA_POOL:=default}"
  : "${PARA_BRIDGE:=incusbr0}"
  : "${PARA_IP_LO:=200}"
  : "${PARA_IP_HI:=249}"
  : "${PARA_USER:=app}"
  : "${PARA_UID:=1000}"
  : "${PARA_GID:=1000}"
  : "${PARA_CLONE_DIR:=app}"
  : "${PARA_CLONE_BRANCH:=}"
  : "${PARA_ORIGIN:=}"
  : "${PARA_BASE_IMAGE:=}"
  : "${PARA_IMAGE_BOOTSTRAP:=}"
  : "${PARA_READY_HOST:=}"
  # Caddy's admin endpoint. Empty means Caddy's own default (localhost:2019),
  # which every Caddy on the box shares — set this to give para's Caddy an
  # address of its own when something else is already using it.
  : "${PARA_CADDY_ADMIN:=}"
  : "${PARA_WORKCOPY_HOST:=localhost}"
  : "${PARA_WORKCOPY_PORT:=}"
  # Identity, and the three names derived from it. Deriving PARA_IMAGE per
  # project matters: incus image aliases are daemon-global, so a fixed default
  # would have one project's build republish another's image.
  : "${PARA_PROJECT:=$(slug "${PARA_PROJECT_DIR##*/}")}"
  : "${PARA_IMAGE:=$PARA_PROJECT}"
  : "${PARA_VOLUME:=para-home-$PARA_PROJECT}"
  : "${PARA_HOST_ENV:=$PARA_PROJECT_DIR/.env}"
  PARA_ROUTES="$(normalize_routes "${PARA_ROUTES:-}")"
  PARA_SHARED=/para/shared
  # Set last, so neither file can claim a contract para doesn't provide.
  PARA_CONTRACT=2
}

find_project_root() {
  local dir="$PWD"
  while [ "$dir" != / ]; do
    if [ -d "$dir/.paraspace" ]; then printf '%s' "$dir"; return; fi
    dir="$(dirname "$dir")"
  done
  return 1
}

# A directory name as a project slug: lowercase, everything else a hyphen.
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-'; }

# Routes may be written with commas, spaces, tabs or newlines. The canonical
# form is lowercase and space-separated — what para stamps on the container,
# injects as $PARA_ROUTES, and reads back with plain word splitting. Also used
# on the way back out of incus, where a stamp made by an older para may still
# be comma-separated and therefore CSV-quoted.
normalize_routes() {
  local routes
  routes="$(printf '%s' "$1" | tr -d '"' | tr ',\t\n' '   ' | tr -s ' ' | tr '[:upper:]' '[:lower:]')"
  routes="${routes# }"          # -s left at most one space at each edge
  printf '%s' "${routes% }"
}

# Commands that clone, boot or build need a project; the rest work anywhere.
require_project() {
  [ -n "$PARA_PROJECT_DIR" ] \
    || die "not inside a para project — no .paraspace/ directory from \$PWD upward. cd into one, or set PARA_PROJECT_DIR."
  if [ -n "${PARA_VERSION:-}" ] && [ "$PARA_VERSION" != "$PARA_CONTRACT" ]; then
    die "this project targets para contract $PARA_VERSION, but this para provides $PARA_CONTRACT — see docs/versioning.md."
  fi
}

# Every PARA_* in scope, as export lines. This is the one way para hands its
# context to anything it runs for you: guest hooks, project commands, and the
# image-build payload. A key you invent in your Parafile reaches all three.
para_env() {
  local var
  for var in "${!PARA_@}"; do printf 'export %s=%q\n' "$var" "${!var}"; done
}

validate_name() {
  [[ "$1" =~ ^[a-z][a-z0-9-]{0,30}$ ]] \
    || die "invalid workspace name '$1' — lowercase letters, digits and hyphens, starting with a letter (max 31)."
}

# ---- URLs ------------------------------------------------------------------
# The ":port" para URLs carry — empty on :443.
url_port() { [ "$PARA_HTTPS_PORT" = 443 ] || printf ':%s' "$PARA_HTTPS_PORT"; }

# "[sub:]port" -> the Caddy site host for <workspace> on <domain>.
route_host() { # route_host <route> <name> <domain>
  case "$1" in
    *:*) printf '%s.%s.%s' "${1%%:*}" "$2" "$3" ;;
    *)   printf '%s.%s' "$2" "$3" ;;
  esac
}

# The apex URL — empty unless a bare port routes it. A subdomain-only project
# has no site at https://<name>.<domain>, so there is nothing to print.
ws_url() { # ws_url <name> <domain> <routes>
  local route
  # shellcheck disable=SC2086  # routes are space-separated by construction
  for route in $3; do
    case "$route" in *:*) continue ;; esac
    printf 'https://%s.%s%s' "$1" "$2" "$(url_port)"
    return
  done
}

# Every URL a workspace publishes, one per line.
ws_urls() { # ws_urls <name> <domain> <routes>
  local route
  # shellcheck disable=SC2086  # routes are space-separated by construction
  for route in $3; do
    printf 'https://%s%s\n' "$(route_host "$route" "$1" "$2")" "$(url_port)"
  done
}

# ---- incus is the registry -------------------------------------------------
# A workspace records its own project, routes and domain in its container's
# user config, and its IP in its eth0 device. incus can return all of it in one
# query, so para keeps no registry of its own and can't drift from one.
ws_list() { # ws_list [<project>] — CSV: name,state,project,domain,ip,routes
  if [ -n "${1:-}" ]; then
    incus list "^$CT_PREFIX" "user.para.project=$1" -f csv -c "$WS_COLS"
  else
    incus list "^$CT_PREFIX" -f csv -c "$WS_COLS"
  fi
}

# Load workspace <name> into ws_state/ws_project/ws_domain/ws_ip/ws_routes.
# Non-zero if there is no such workspace.
ws_load() {
  local row
  row="$(ws_list | awk -F, -v ct="$CT_PREFIX$1" '$1 == ct')"
  [ -n "$row" ] || return 1
  # shellcheck disable=SC2034  # a row reader exposes the whole row, used or not
  IFS=, read -r _ ws_state ws_project ws_domain ws_ip ws_routes <<<"$row"
  ws_routes="$(normalize_routes "$ws_routes")"
}

instance_exists() { incus info "$1" >/dev/null 2>&1; }

# incus's carriage-return progress bars are noise once captured to a file.
incus_q() { if [ -t 2 ]; then incus "$@"; else incus --quiet "$@"; fi; }

require_incus() {
  need incus
  incus info >/dev/null 2>&1 \
    || die "incus is not reachable — start it (macOS: colima start --runtime incus), then try 'para doctor'."
}

# Mirror this workspace's identity onto its container, refreshed on every up.
stamp_ct() { # stamp_ct <ct>
  incus config set "$1" \
    "user.para.project=$PARA_PROJECT" \
    "user.para.domain=$PARA_DOMAIN" \
    "user.para.routes=$PARA_ROUTES"
}

bridge_prefix() { # "192.168.100.1/24" -> "192.168.100"
  local addr
  addr="$(incus network get "$PARA_BRIDGE" ipv4.address 2>/dev/null)" \
    || die "cannot read $PARA_BRIDGE ipv4.address — is the bridge up? ('para doctor')"
  addr="${addr%/*}"
  printf '%s' "${addr%.*}"
}

# A free static IP in the bridge's <prefix>.$PARA_IP_LO-$PARA_IP_HI band. Reads
# the addresses incus has actually pinned, across all incus projects — the
# bridge is machine-global, so anything else fails open onto a live container.
alloc_ip() {
  local prefix used n
  prefix="$(bridge_prefix)"
  # Two sources, because neither is complete: the runtime address (empty while an
  # instance is stopped) and the pinned device address (absent on instances para
  # did not create). Reduced to bare addresses — incus annotates the runtime
  # column as "10.0.0.5 (eth0)", and a whole-line match would miss every one.
  used="$(incus list --all-projects -f csv -c '4,devices:eth0.ipv4.address' \
    | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}')"
  for n in $(seq "$PARA_IP_LO" "$PARA_IP_HI"); do
    if ! grep -qxF "$prefix.$n" <<<"$used"; then printf '%s' "$prefix.$n"; return; fi
  done
  die "no free IP in $prefix.$PARA_IP_LO-$PARA_IP_HI — remove a workspace, or widen PARA_IP_LO/HI."
}

# The shared home volume: one authenticated home per project, attached to every
# workspace of it. security.shifted is what lets a single volume attach to many
# unprivileged containers with correctly shifted ownership — do not drop it.
ensure_volume() {
  if incus storage volume show "$PARA_POOL" "$PARA_VOLUME" >/dev/null 2>&1; then return; fi
  log "Creating shared volume '$PARA_VOLUME' on pool '$PARA_POOL'…"
  incus storage volume create "$PARA_POOL" "$PARA_VOLUME" security.shifted=true
}

attach_volume() { # attach_volume <ct>
  local devices
  devices="$(incus config device show "$1")"
  case "$devices" in *parahome:*) return ;; esac
  incus storage volume attach "$PARA_POOL" "$PARA_VOLUME" "$1" parahome "$PARA_SHARED"
}

# Block until the guest can actually be provisioned: the incus agent answers,
# and — if the project named a host it depends on — DNS resolves it.
wait_ready() { # wait_ready <ct>
  log "Waiting for $1…"
  for _ in $(seq 1 60); do
    if incus exec "$1" -- true 2>/dev/null; then
      [ -n "$PARA_READY_HOST" ] || return 0
      if incus exec "$1" -- getent hosts "$PARA_READY_HOST" >/dev/null 2>&1; then return 0; fi
    fi
    sleep 2
  done
  die "$1 was not ready in ~120s (agent, or guest DNS for '$PARA_READY_HOST'). Check: incus info --show-log $1"
}

# ---- Caddy -----------------------------------------------------------------
# True only if OUR Caddy is running. The pidfile survives a reboot, so kill -0
# alone can match an unrelated process that inherited the PID.
caddy_running() {
  [ -f "$CADDY_PID" ] || return 1
  local pid
  pid="$(cat "$CADDY_PID")"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  case "$(ps -p "$pid" -o comm= 2>/dev/null)" in *caddy*) return 0 ;; *) return 1 ;; esac
}

caddy_globals() {
cat <<EOF
{
	# Internal CA only — no ACME, so nothing needs to bind :80.
	auto_https disable_redirects
${PARA_CADDY_ADMIN:+	admin $PARA_CADDY_ADMIN
}}
EOF
}

# Optional passthrough so a stack you run on the HOST keeps its familiar URL.
# If that stack terminates TLS with SNI, dial it by name so the handshake matches.
caddy_workcopy() {
  [ -n "$PARA_WORKCOPY_PORT" ] || return 0
cat <<EOF

# Working copy passthrough.
https://localhost$(url_port), https://local.$PARA_DOMAIN$(url_port) {
	reverse_proxy https://127.0.0.1:$PARA_WORKCOPY_PORT {
		header_up Host $PARA_WORKCOPY_HOST
		transport http {
			tls_server_name $PARA_WORKCOPY_HOST
			tls_insecure_skip_verify
		}
	}
	tls internal
}
EOF
}

# One site per route, for every para workspace on this machine — each served by
# ITS OWN recorded domain and routes, so one Caddy is correct across projects.
caddy_sites() {
  local name state project domain ip routes route ws
  while IFS=, read -r name state project domain ip routes; do
    ws="${name#"$CT_PREFIX"}"
    routes="$(normalize_routes "$routes")"
    if [ -z "$project" ] || [ -z "$ip" ] || [ -z "$routes" ]; then continue; fi
    printf '\n# workspace %s (%s)\n' "$ws" "$project"
    # shellcheck disable=SC2086  # routes are space-separated by construction
    for route in $routes; do
      printf 'https://%s%s {\n\treverse_proxy %s:%s\n\ttls internal\n}\n\n' \
        "$(route_host "$route" "$ws" "$domain")" "$(url_port)" "$ip" "${route##*:}"
    done
  done < <(ws_list)
}

# Regenerate the Caddyfile from incus and make Caddy adopt it — starting Caddy
# if it isn't running, which is what a bare `para up` relies on. `caddy
# validate` is the route validator: it catches a bad port or two workspaces
# claiming one hostname, and says which, before anything is live.
caddy_sync() {
  need caddy
  mkdir -p "$PARA_STATE_DIR"
  { caddy_globals; caddy_workcopy; caddy_sites; } > "$CADDYFILE"
  caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null \
    || die "the generated Caddyfile is invalid (above) — check PARA_ROUTES and PARA_DOMAIN. It is at $CADDYFILE."
  if caddy_running; then
    caddy reload --config "$CADDYFILE" --adapter caddyfile
    return
  fi
  log "Starting para Caddy on :$PARA_HTTPS_PORT…"
  rm -f "$CADDY_PID"
  caddy start --config "$CADDYFILE" --adapter caddyfile --pidfile "$CADDY_PID" \
    || die "caddy could not start on :$PARA_HTTPS_PORT — 'para doctor' checks the usual causes."
  warn "If browsers distrust the certificates, run once:  caddy trust"
}

# ---- the one door into a workspace -----------------------------------------
# Every guest execution goes through here — `para sh`, hooks, and (via `para
# sh`) project commands — so the terminal handling is stated once:
#
#   su -       runs initgroups, so the user's supplementary groups load. That
#              is why this is not `incus exec --user`: without the docker group
#              the stack hits permission denied on the socket.
#   su --pty   with -c, plain su stays the terminal's foreground process and
#              drops SIGWINCH, so a TUI never repaints on resize. --pty proxies
#              the tty and forwards resizes to the child. (util-linux su —
#              busybox has no --pty, so an interactive shell needs a real one.)
#   -t / -T    a pty only when BOTH our ends are terminals. A pty echoes NULs
#              and turns \n into \r\n, so forcing one on stdin alone dirties
#              `para sh x -c … | tee`, `> file` and `$(…)`. Explicit in both
#              directions, because incus's auto mode ignores PARA_NONINTERACTIVE.
#   -s bash    deterministic semantics for -c, whatever login shell the image
#              gives $PARA_USER. Hooks run by path, so their shebang decides.
ws_exec() { # ws_exec <name> [<command>]
  local ct="$CT_PREFIX$1"
  if [ "$#" -lt 2 ]; then
    incus exec "$ct" -t -- su - "$PARA_USER"
  elif interactive; then
    incus exec "$ct" -t -- su --pty - "$PARA_USER" -s /bin/bash -c "$GUEST_PRELUDE$2"
  else
    incus exec "$ct" -T -- su - "$PARA_USER" -s /bin/bash -c "$GUEST_PRELUDE$2"
  fi
}

# ---- hooks -----------------------------------------------------------------
# Push the project's .paraspace/ into the workspace as ~/.paraspace, alongside
# para's context and the project's base .env. Fresh on every up, so an edit to
# a hook takes effect without re-cloning anything.
push_project() { # push_project <name>
  local ct="$CT_PREFIX$1" home="/home/$PARA_USER"
  incus exec "$ct" -- rm -rf "$home/.paraspace"
  incus_q file push -r "$PARA_PROJECT_DIR/.paraspace" "$ct$home/"
  para_env | incus_q file push --mode 0600 - "$ct$home/.paraspace/env"
  if [ -f "$PARA_HOST_ENV" ]; then
    incus_q file push --mode 0600 "$PARA_HOST_ENV" "$ct$home/.paraspace/host.env"
  fi
  incus exec "$ct" -- chown -R "$PARA_UID:$PARA_GID" "$home/.paraspace"
  # A hook is run by path so its shebang decides, which needs the exec bit —
  # and a checkout, a tarball or a push can all lose it.
  if [ -d "$PARA_PROJECT_DIR/.paraspace/hooks" ]; then
    incus exec "$ct" -- chmod -R +x "$home/.paraspace/hooks"
  fi
}

# Run one of the project's guest hooks, if it has one. Hooks own all
# provisioning; para only decides when they run. docs/hooks.md.
run_hook() { # run_hook <hook> <name>
  if [ ! -f "$PARA_PROJECT_DIR/.paraspace/hooks/$1" ]; then
    log "No '$1' hook — skipping."
    return
  fi
  log "Running hook: $1"
  ws_exec "$2" "exec ~/.paraspace/hooks/$1" || die "the '$1' hook failed."
}

# The per-workspace half of the hook environment. Everything else a hook sees
# is already a PARA_* in scope, and para_env forwards them all.
# shellcheck disable=SC2034  # every one of these is read by para_env's ${!PARA_@}
workspace_context() { # workspace_context <name>
  PARA_NAME="$1"
  PARA_URL="$(ws_url "$1" "$PARA_DOMAIN" "$PARA_ROUTES")"
  PARA_HOSTNAME="$(hostname -s 2>/dev/null || hostname)"
  PARA_GIT_NAME="$(git config --global user.name 2>/dev/null || true)"
  PARA_GIT_EMAIL="$(git config --global user.email 2>/dev/null || true)"
}

# ---- workspace lifecycle ---------------------------------------------------
# On a failed `up`, point at the one command that knows how a host misbehaves.
up_hint() { [ "$1" -eq 0 ] || warn "if that reads like a host problem rather than a project one, run: para doctor"; }

cmd_up() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: para up <name>"
  validate_name "$name"
  require_project
  require_incus
  # Container names are machine-global, so refuse to adopt another project's.
  if ws_load "$name" && [ "$ws_project" != "$PARA_PROJECT" ]; then
    die "workspace '$name' belongs to project '$ws_project' — names are unique per machine, pick another."
  fi
  trap 'up_hint $?' EXIT

  local ct="$CT_PREFIX$name" ip
  ensure_volume
  if instance_exists "$ct"; then
    log "Workspace '$name' exists — restarting and reconverging…"
    incus start "$ct" 2>/dev/null || true
  else
    incus image info "$PARA_IMAGE" >/dev/null 2>&1 \
      || die "no image '$PARA_IMAGE' — build it first with 'para image build'."
    ip="$(alloc_ip)"
    log "Launching $ct at $ip…"
    incus launch "$PARA_IMAGE" "$ct" --storage "$PARA_POOL" \
      -c security.nesting=true -d eth0,ipv4.address="$ip"
  fi
  attach_volume "$ct"
  stamp_ct "$ct"
  wait_ready "$ct"
  # A fresh volume's root is root-owned; para owns the volume, so para makes it
  # writable before the (unprivileged) provision hook seeds it.
  incus exec "$ct" -- chown "$PARA_UID:$PARA_GID" "$PARA_SHARED"

  workspace_context "$name"
  push_project "$name"
  run_hook provision "$name"
  log "Booting the stack — the first run pulls images, so be patient…"
  run_hook boot "$name"
  caddy_sync
  trap - EXIT
  local urls
  urls="$(ws_urls "$name" "$PARA_DOMAIN" "$PARA_ROUTES" | tr '\n' ' ')"
  if [ -n "$urls" ]; then
    log "Workspace '$name' ready → $urls"
  else
    log "Workspace '$name' ready — no HTTP routes declared, so 'para sh $name' for a shell."
  fi
}

cmd_down() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: para down <name>"
  require_incus
  ws_load "$name" || die "no such workspace '$name' (see: para ls)"
  if [ "$ws_state" != RUNNING ]; then
    warn "workspace '$name' is already stopped"
    return
  fi
  incus stop "$CT_PREFIX$name"
  log "Workspace '$name' stopped — data is kept, 'para up $name' resumes it."
}

cmd_rm() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: para rm <name>"
  validate_name "$name"
  require_incus
  local ct="$CT_PREFIX$name"
  # Converging on "gone", so an already-absent workspace is a no-op — teardown
  # scripts rely on that, and it is still said out loud in case of a typo.
  if ! instance_exists "$ct"; then
    warn "no workspace '$name' to remove (see: para ls)"
    return
  fi
  log "Deleting $ct…"
  incus delete -f "$ct"
  caddy_sync
  log "Removed workspace '$name'. The shared volume is untouched."
}

cmd_ls() {
  local all=0 names=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -a|--all) all=1; shift ;;
      --names)  names=1; shift ;;
      *) die "usage: para ls [-a|--all] [--names]" ;;
    esac
  done
  require_incus
  # Scoped to this project by default — and to everything when asked, or when
  # there is no project to scope to.
  local scope="$PARA_PROJECT"
  [ "$all" -eq 0 ] || scope=""

  local name state project domain ip routes ws
  [ "$names" -eq 1 ] || printf '%-20s %-9s %-16s %-14s %s\n' NAME STATE IP PROJECT URL
  while IFS=, read -r name state project domain ip routes; do
    [ -n "$project" ] || continue
    ws="${name#"$CT_PREFIX"}"
    if [ "$names" -eq 1 ]; then
      printf '%s\n' "$ws"
    else
      printf '%-20s %-9s %-16s %-14s %s\n' "$ws" "$state" "$ip" "$project" \
        "$(ws_url "$ws" "$domain" "$(normalize_routes "$routes")")"
    fi
  done < <(ws_list "$scope")
}

cmd_sh() {
  local usage="usage: para sh <name> [-c <command>] — the command as ONE quoted string"
  local name="" cmd="" have_cmd=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -c) shift; [ "$#" -gt 0 ] || die "$usage"
          cmd="$1"; have_cmd=1; shift ;;
      -*) die "$usage" ;;
      *)  [ -z "$name" ] || die "unexpected argument: $1"
          name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "$usage"
  require_incus
  ws_load "$name" || die "no such workspace '$name' (see: para ls)"
  [ "$ws_state" = RUNNING ] || die "workspace '$name' is $ws_state — 'para up $name' first."
  if [ "$have_cmd" -eq 1 ]; then ws_exec "$name" "$cmd"; else ws_exec "$name"; fi
}

# ---- host side -------------------------------------------------------------
cmd_caddy() {
  case "${1:-}" in
    start)
      require_incus
      caddy_sync
      log "para Caddy is up on :$PARA_HTTPS_PORT."
      ;;
    stop)
      # By pidfile, not `caddy stop`: that goes through the admin endpoint, which
      # several Caddys can share, so it might stop somebody else's. SIGTERM is a
      # graceful shutdown for Caddy anyway.
      if ! caddy_running; then log "para Caddy is not running."; return; fi
      kill "$(cat "$CADDY_PID")"
      rm -f "$CADDY_PID"
      log "para Caddy stopped. Workspaces keep running."
      ;;
    status)
      if caddy_running; then
        log "para Caddy is running (pid $(cat "$CADDY_PID")) on :$PARA_HTTPS_PORT — $CADDYFILE"
      else
        log "para Caddy is not running — 'para caddy start'."
      fi
      ;;
    *) die "usage: para caddy <start|stop|status>" ;;
  esac
}

cmd_config() {
  case "${1:-}" in
    path) printf '%s\n' "$PARA_CONFIG" ;;
    init)
      if [ -f "$PARA_CONFIG" ] && [ "${2:-}" != --force ]; then
        die "$PARA_CONFIG already exists — edit it, or 'para config init --force' to replace it."
      fi
      mkdir -p "$PARA_CONFIG_DIR"
      config_template > "$PARA_CONFIG"
      log "Wrote $PARA_CONFIG — every line is commented out; uncomment what you want to change."
      ;;
    *) die "usage: para config <init [--force]|path>" ;;
  esac
}

# Generated from para's own resolved values, so the box-level knobs are listed
# in exactly one place and the seeded file can never drift from the defaults.
config_template() {
  local key
  cat <<-'EOF'
	# para user config — sourced as bash, like a project's Parafile.
	#
	#   : "${PARA_X:=value}"   yields to the environment
	#   PARA_X=value           insists
	#
	# This describes your BOX. Per-project settings (routes, image, origin…)
	# belong in the project's .paraspace/Parafile. Nothing enforces that; `para
	# doctor` will tell you when a value here looks project-shaped.
	EOF
  for key in PARA_DOMAIN PARA_HTTPS_PORT PARA_POOL PARA_BRIDGE PARA_IP_LO PARA_IP_HI; do
    # shellcheck disable=SC2016  # the := idiom is the literal being written
    printf '# : "${%s:=%s}"\n' "$key" "${!key}"
  done
}

# ---- base image ------------------------------------------------------------
cmd_image() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    build)  cmd_image_build "$@" ;;
    status) cmd_image_status ;;
    rm)     cmd_image_rm ;;
    *) die "usage: para image <build [-i]|status|rm>" ;;
  esac
}

# The reproducibility surface of a build, hashed: the payload, the bootstrap
# line, and the base it layers on. `image status` compares it against the hash
# stamped at publish time to say whether a rebuild would produce something else.
image_src_sha() {
  {
    printf '%s\n%s\n' "$PARA_BASE_IMAGE" "$PARA_IMAGE_BOOTSTRAP"
    cat "$PARA_PROJECT_DIR/.paraspace/image-build.sh"
  } | sha256_of
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256
  else die "need sha256sum or shasum to hash the image source"; fi | awk '{print $1}'
}

cmd_image_build() {
  require_project
  local from_current=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -i|--from-current) from_current=1; shift ;;
      *) die "usage: para image build [-i|--from-current]" ;;
    esac
  done
  # Everything the project itself has to get right, checked before the daemon —
  # an incomplete Parafile is more useful to hear about than an absent incus.
  local payload="$PARA_PROJECT_DIR/.paraspace/image-build.sh"
  [ -f "$payload" ] || die "missing provisioning payload: $payload"
  local base="$PARA_BASE_IMAGE"
  [ "$from_current" -eq 0 ] || base="$PARA_IMAGE"
  [ -n "$base" ] \
    || die "PARA_BASE_IMAGE is not set — name the incus image to build from in .paraspace/Parafile, e.g. : \"\${PARA_BASE_IMAGE:=images:debian/13}\". See docs/image.md."

  require_incus
  if [ "$from_current" -eq 1 ]; then
    incus image info "$base" >/dev/null 2>&1 \
      || die "no existing '$base' image to build from — run a plain 'para image build' first."
  fi

  # Script scope, not local: the EXIT trap fires after this function unwinds.
  builder=para-image-build
  tmp_alias="para-image-tmp-$PARA_PROJECT"
  published=0
  trap image_cleanup EXIT
  trap 'echo >&2; warn "interrupted — removing the builder…"; exit 130' INT TERM

  if instance_exists "$builder"; then incus delete -f "$builder"; fi
  log "Launching the builder from '$base'…"
  incus_q launch "$base" "$builder" --storage "$PARA_POOL" -c security.nesting=true
  wait_ready "$builder"
  # The payload runs under `bash -s`, and a minimal base may not ship bash (or
  # may need its package index refreshed first). `sh` is the one interpreter
  # every base image has, which is what this line is for.
  if [ "$from_current" -eq 0 ] && [ -n "$PARA_IMAGE_BOOTSTRAP" ]; then
    log "Bootstrapping the builder…"
    incus exec "$builder" -- sh -c "$PARA_IMAGE_BOOTSTRAP"
  fi
  log "Provisioning the image — this takes a few minutes…"
  # Backgrounded so Ctrl-C works: a foreground `incus exec` reading a script on
  # stdin can't be given a pty, so incus never relays SIGINT into the container
  # and bash can't interrupt the wait. `wait` can be interrupted, which runs the
  # INT trap, which tears the builder down.
  { para_env; cat "$payload"; } | incus exec "$builder" -- bash -s &
  wait "$!"
  image_publish
  # Before the traps are cleared, so an interrupt here is still covered.
  incus delete -f "$builder"
  trap - EXIT INT TERM
  log "Image '$PARA_IMAGE' ready. Now: para up <name>"
}

# Stop, snapshot, publish to a temp alias, then swap. Each step is deliberate:
# a force-stop because a container init that ignores the shutdown signal never
# halts; a snapshot because publishing a just-stopped instance races its rootfs
# settling; a temp alias because publishing over the live alias would leave the
# box with no image at all if the publish failed.
image_publish() {
  incus stop -f "$builder"
  incus snapshot create "$builder" publish
  log "Publishing as '$PARA_IMAGE'…"
  incus_q publish "$builder/publish" --reuse --alias "$tmp_alias"
  published=1
  incus image delete "$PARA_IMAGE" >/dev/null 2>&1 || true
  incus image alias rename "$tmp_alias" "$PARA_IMAGE"
  incus image set-property "$PARA_IMAGE" user.para.src_sha "$(image_src_sha)"
}

# Never delete the temp alias once it holds the only copy of the image.
image_cleanup() {
  [ "$published" -eq 1 ] || incus image delete "$tmp_alias" >/dev/null 2>&1 || true
  incus delete -f "$builder" >/dev/null 2>&1 || true
}

cmd_image_status() {
  require_project
  require_incus
  local info
  info="$(incus image info "$PARA_IMAGE" 2>/dev/null)" \
    || die "no '$PARA_IMAGE' image yet — build it with: para image build"
  local built sha source
  built="$(awk -F'Uploaded: *' '/Uploaded:/{print $2; exit}' <<<"$info")"
  sha="$(incus image get-property "$PARA_IMAGE" user.para.src_sha 2>/dev/null || true)"
  if [ -z "$sha" ]; then source="unknown — this image predates provenance stamping"
  elif [ "$sha" = "$(image_src_sha)" ]; then source="up to date"
  else source="drifted — the image inputs changed since this build"; fi
  printf '  image    %s\n  built    %s\n  base     %s\n  source   %s\n' \
    "$PARA_IMAGE" "${built:-unknown}" "${PARA_BASE_IMAGE:-<unset>}" "$source"
}

cmd_image_rm() {
  require_project
  require_incus
  incus image info "$PARA_IMAGE" >/dev/null 2>&1 || die "no '$PARA_IMAGE' image to remove."
  incus image delete "$PARA_IMAGE"
  log "Removed image '$PARA_IMAGE'. Rebuild with: para image build"
}

# ---- scaffolding -----------------------------------------------------------
# This script's package root, through any symlink chain — npm global installs,
# npx, and a source checkout all land here. Plain readlink, not readlink -f,
# which macOS doesn't have.
pkg_root() {
  local self="$0" dir link
  while [ -L "$self" ]; do
    dir="$(cd -P "$(dirname "$self")" && pwd)"
    link="$(readlink "$self")"
    case "$link" in /*) self="$link" ;; *) self="$dir/$link" ;; esac
  done
  cd -P "$(dirname "$self")/.." && pwd
}

cmd_init() {
  local template="" force=0 full=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --list)     template_names; return ;;
      -f|--force) force=1; shift ;;
      --full)     full=1; shift ;;
      -*) die "usage: para init [<template>] [--list] [-f|--force] [--full]" ;;
      *)  template="$1"; shift ;;
    esac
  done
  local src
  template="${template:-void-docker-gh}"
  # A bundled template is a plain directory name. Without this, `para init ../..`
  # would scaffold an arbitrary tree into the current directory.
  case "$template" in
    */*|.|..) die "a template is a plain directory name (see: para init --list); got '$template'." ;;
  esac
  src="$(pkg_root)/templates/$template"
  [ -d "$src" ] || die "no such template '$template' (see: para init --list)."
  local root="$src/.paraspace"
  [ "$full" -eq 0 ] || root="$src"

  log "Scaffolding '$template' into $PWD…"
  local file rel dest added=0 skipped=0
  while IFS= read -r file; do
    rel="${file#"$src"/}"
    [ "$rel" != README.md ] || continue    # the template's own README, not yours
    dest="$PWD/$rel"
    if [ -e "$dest" ] && [ "$force" -eq 0 ]; then
      printf '  skip (exists): %s\n' "$rel" >&2
      skipped=$((skipped + 1))
      continue
    fi
    mkdir -p "$(dirname "$dest")"
    cp "$file" "$dest"
    case "$rel" in .paraspace/hooks/*|.paraspace/commands/*|*.sh) chmod +x "$dest" ;; esac
    printf '  add: %s\n' "$rel" >&2
    added=$((added + 1))
  done < <(find "$root" -type f)
  log "Done — $added added, $skipped skipped."
  [ "$added" -eq 0 ] \
    || log "Next: edit .paraspace/Parafile (PARA_ORIGIN, PARA_ROUTES), then 'para image build' and 'para up <name>'."
}

template_names() {
  local dir
  for dir in "$(pkg_root)"/templates/*/; do
    if [ -d "$dir" ]; then printf '%s\n' "$(basename "$dir")"; fi
  done
}

# ---- project commands ------------------------------------------------------
# A project extends para by dropping an executable in .paraspace/commands/:
# `para <verb>` then runs it on the HOST, with every PARA_* exported and its
# arguments passed through. Engine verbs always win. docs/commands.md.
project_commands() {
  local file
  for file in "$PARA_PROJECT_DIR"/.paraspace/commands/*; do
    if [ -f "$file" ]; then printf '%s\n' "${file##*/}"; fi
  done
}

# The "# summary: …" line a project command may carry, for `para --help`.
command_summary() { sed -n '1,5s/^# summary: *//p' "$1"; }

run_project_command() {
  local verb="$1" script="$PARA_PROJECT_DIR/.paraspace/commands/$1"
  shift
  if [ -z "$PARA_PROJECT_DIR" ] || [ ! -f "$script" ]; then
    die "unknown command '$verb' — see 'para --help'."
  fi
  export "${!PARA_@}"
  exec "$script" "$@"
}

# ---- diagnosis -------------------------------------------------------------
# Everything para knows about how a host can be wrong lives here, so that the
# commands you use every day don't carry it. Run it when something is off.
DOCTOR_FAILED=0
d_ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
d_warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
d_bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; DOCTOR_FAILED=1; }

cmd_doctor() {
  # Every check below reads something that may be absent or broken — that IS the
  # job — so this one command does not inherit `set -e`. Without it a diagnostic
  # stops at the first thing it cannot read, which is the moment you most need
  # the rest of the report.
  set +e
  printf '\nconfig\n'
  doctor_config
  printf '\nhost\n'
  doctor_host
  printf '\nincus\n'
  doctor_incus
  printf '\nproject\n'
  doctor_project
  printf '\n'
  [ "$DOCTOR_FAILED" -eq 0 ] || die "some checks failed — see above."
}

doctor_config() {
  printf '    user config   %s\n' "$PARA_CONFIG"
  printf '    state         %s\n' "$PARA_STATE_DIR"
  printf '    project dir   %s\n' "${PARA_PROJECT_DIR:-<none>}"
  printf '    PARA_PROJECT  %s\n' "${PARA_PROJECT:-<none>}"
  printf '    PARA_IMAGE    %s\n' "$PARA_IMAGE"
  printf '    PARA_DOMAIN   %s\n' "$PARA_DOMAIN"
  printf '    PARA_ROUTES   %s\n' "${PARA_ROUTES:-<none>}"
  printf '    PARA_POOL     %s\n' "$PARA_POOL"
  printf '    PARA_VOLUME   %s\n' "$PARA_VOLUME"
  printf '    Caddy port    %s\n' "$PARA_HTTPS_PORT"
  # The user config describes your box, so a project-shaped key there applies
  # to every project on it. Nothing refuses that; this says it out loud.
  local key
  for key in PARA_PROJECT PARA_IMAGE PARA_ORIGIN PARA_ROUTES PARA_BASE_IMAGE PARA_VOLUME; do
    if [ -f "$PARA_CONFIG" ] && grep -q "^[^#]*$key" "$PARA_CONFIG"; then
      d_warn "$key is set in the user config, so it applies to EVERY project on this box — it probably belongs in a Parafile."
    fi
  done
}

doctor_host() {
  if command -v caddy >/dev/null 2>&1; then d_ok "caddy present"; else d_bad "caddy not on PATH"; fi
  if caddy_running; then d_ok "para Caddy running on :$PARA_HTTPS_PORT"
  else d_warn "para Caddy not running ('para caddy start', or any 'para up')"; fi
  # Binding a port below 1024 as a normal user needs the capability on the binary.
  if [ "$PARA_HTTPS_PORT" -lt 1024 ] && command -v getcap >/dev/null 2>&1; then
    local bin
    bin="$(readlink -f "$(command -v caddy)")"
    if getcap "$bin" 2>/dev/null | grep -q cap_net_bind_service; then
      d_ok "caddy may bind :$PARA_HTTPS_PORT"
    else
      d_bad "caddy cannot bind :$PARA_HTTPS_PORT unprivileged — sudo setcap cap_net_bind_service=+ep $bin (re-apply after a caddy upgrade), or use the default :8443"
    fi
  fi
  # The wildcard must resolve to this machine or no workspace URL will load.
  if ! command -v getent >/dev/null 2>&1; then
    d_warn "no getent here — check by hand that *.$PARA_DOMAIN resolves to 127.0.0.1"
  elif getent hosts "doctor.$PARA_DOMAIN" | grep -q '^127\.'; then
    d_ok "*.$PARA_DOMAIN resolves to 127.0.0.1"
  else
    d_bad "*.$PARA_DOMAIN does not resolve to 127.0.0.1 — workspace URLs will not load (docs/urls.md)"
  fi
  # A named cgroup-v1 hierarchy under /sys/fs/cgroup makes LXC fail every
  # container start with a cryptic "Failed to create cgroup at_mnt".
  local v1
  v1="$(awk '$3 == "cgroup" && $2 ~ /^\/sys\/fs\/cgroup\//{print $2}' /proc/mounts 2>/dev/null | tr '\n' ' ')"
  [ -z "$v1" ] || d_bad "cgroup-v1 mounted inside /sys/fs/cgroup (${v1% }) — containers will not start until: sudo umount -l ${v1% }"
}

doctor_incus() {
  if ! command -v incus >/dev/null 2>&1; then d_bad "incus not on PATH"; return; fi
  if ! incus info >/dev/null 2>&1; then d_bad "incus daemon unreachable — 'incus admin init', or start colima on macOS"; return; fi
  # The probe decides, not the version: a distro may backport, and an incus that
  # cannot do this rejects the column rather than returning it empty — which
  # would be far worse, since para would read every workspace as address-less.
  local v
  v="$(incus version | awk '/Client version/{print $3}')"
  if ! incus list -f csv -c 'devices:eth0.ipv4.address' >/dev/null 2>&1; then
    d_bad "incus ${v:-?} cannot select device columns, which is how para reads workspace state — upgrade to $MIN_INCUS or newer (Ubuntu's repos ship 6.2)"
  elif [ -n "$v" ] && ! version_ge "$v" "$MIN_INCUS"; then
    d_warn "incus $v is older than the $MIN_INCUS para is tested against — it can do what para needs, but expect surprises"
  else
    d_ok "incus $v"
  fi
  local driver
  driver="$(incus storage list -f csv 2>/dev/null | awk -F, -v p="$PARA_POOL" '$1 == p {print $2}')"
  if [ -z "$driver" ]; then
    d_bad "storage pool '$PARA_POOL' does not exist — incus storage create $PARA_POOL dir"
  else
    d_ok "pool '$PARA_POOL' ($driver)"
    doctor_storage "$driver"
  fi
  if incus network get "$PARA_BRIDGE" ipv4.address >/dev/null 2>&1; then
    d_ok "bridge '$PARA_BRIDGE' up"
  else
    d_bad "bridge '$PARA_BRIDGE' has no ipv4.address"
  fi
}

# Nested Docker on btrfs, or on ZFS before 2.2, silently falls back to the vfs
# storage driver — the slowest failure para has. And the shared volume needs
# idmapped mounts, without which a workspace dies mid-boot with "Required
# idmapping abilities not available".
doctor_storage() {
  local driver="$1" zv
  case "$(uname -s)/$driver" in
    Linux/btrfs|Linux/zfs)
      d_warn "pool '$PARA_POOL' is $driver-backed — nested Docker falls back to vfs. Put para on a dir pool over ext4/xfs: incus storage create para-dir dir source=/path/on/ext4" ;;
  esac
  if ! grep -qw shiftfs /proc/filesystems 2>/dev/null; then
    if [ "$(incus info | awk -F'"' '/^[[:space:]]*idmapped_mounts:/{print $2; exit}')" = false ]; then
      d_bad "this kernel cannot do idmapped mounts, which the shared volume needs — upgrade to >= 5.12 (>= 5.15 for btrfs)"
    fi
    zv="$(zfs_version)"
    if [ -n "$zv" ] && ! version_ge "$zv" 2.2; then
      d_warn "OpenZFS $zv is older than 2.2 — if the pool lives on ZFS, the shared volume will fail to attach at boot"
    fi
  fi
}

zfs_version() { sed 's/-.*//' /sys/module/zfs/version 2>/dev/null || true; }
version_ge() { [ "$1" = "$2" ] || [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }

doctor_project() {
  if [ -z "$PARA_PROJECT_DIR" ]; then d_warn "not inside a para project"; return; fi
  if [ -z "${PARA_VERSION:-}" ]; then
    d_warn "the Parafile declares no PARA_VERSION — add : \"\${PARA_VERSION:=$PARA_CONTRACT}\" so a breaking para change fails loudly"
  elif [ "$PARA_VERSION" = "$PARA_CONTRACT" ]; then
    d_ok "Parafile targets contract $PARA_VERSION"
  else
    d_bad "this project targets contract $PARA_VERSION, but this para provides $PARA_CONTRACT — see docs/versioning.md"
  fi
  if [ -n "$PARA_ROUTES" ]; then d_ok "routes: $PARA_ROUTES"; else d_warn "no PARA_ROUTES — this project publishes no HTTP"; fi
  if incus image info "$PARA_IMAGE" >/dev/null 2>&1; then d_ok "image '$PARA_IMAGE' exists"
  else d_bad "no image '$PARA_IMAGE' — para image build"; fi
  # A project command that shadows an engine verb never runs.
  local verb
  while IFS= read -r verb; do
    if is_engine_verb "$verb"; then d_warn "project command '$verb' is shadowed by the engine verb of the same name"; fi
  done < <(project_commands)
}

# ---- help ------------------------------------------------------------------
is_engine_verb() {
  case "$1" in
    up|down|rm|ls|sh|caddy|config|image|init|doctor|commands|completions|help) return 0 ;;
    *) return 1 ;;
  esac
}

usage() {
  cat <<-EOF
	para — parallel dev workspaces on Incus

	WORKSPACES
	  up <name>                 create or reconverge a workspace, then boot it
	  down <name>               stop it (data kept)
	  rm <name>                 delete it
	  ls [-a|--all] [--names]   list workspaces, this project's by default
	  sh <name> [-c <command>]  a shell in the clone, or one command in it

	HOST
	  caddy <start|stop|status> the para Caddy that serves *.$PARA_DOMAIN
	  doctor                    check this machine, and print the resolved config
	  config <init|path>        the user config: seed it, or say where it is

	PROJECT
	  init [<template>]         scaffold .paraspace/ into the current directory
	  image <build|status|rm>   the base image workspaces launch from
	  commands                  list this project's own commands
	  completions <bash|zsh>    source <(para completions bash)
	EOF
  usage_project_commands
  cat <<-EOF

	Docs: README.md and docs/. Contract version: $PARA_CONTRACT.
	EOF
}

# A project's own verbs, listed so nothing it added runs invisibly.
usage_project_commands() {
  local list verb
  list="$(project_commands)"
  [ -n "$list" ] || return 0
  printf '\nPROJECT COMMANDS (%s/.paraspace/commands)\n' "$PARA_PROJECT_DIR"
  while IFS= read -r verb; do
    printf '  %-25s %s\n' "$verb" "$(command_summary "$PARA_PROJECT_DIR/.paraspace/commands/$verb")"
  done <<<"$list"
}

cmd_completions() {
  case "${1:-}" in
    bash) ;;
    zsh) cat <<-'EOF'
	if ! whence compdef >/dev/null 2>&1; then autoload -U +X compinit && compinit; fi
	autoload -U +X bashcompinit && bashcompinit
	EOF
      ;;
    *) die "usage: para completions <bash|zsh>  — then: source <(para completions bash)" ;;
  esac
  cat <<-'EOF'
	_para() {
	  local cur="${COMP_WORDS[COMP_CWORD]}" cmd="${COMP_WORDS[1]:-}"
	  local verbs="up down rm ls sh caddy config image init doctor commands completions help"

	  if [ "$COMP_CWORD" -eq 1 ]; then
	    COMPREPLY=( $(compgen -W "$verbs $(para commands 2>/dev/null)" -- "$cur") )
	    return
	  fi
	  case "$cmd" in
	    caddy)       COMPREPLY=( $(compgen -W "start stop status" -- "$cur") ) ;;
	    config)      COMPREPLY=( $(compgen -W "init path" -- "$cur") ) ;;
	    image)       COMPREPLY=( $(compgen -W "build status rm" -- "$cur") ) ;;
	    completions) COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") ) ;;
	    init)        COMPREPLY=( $(compgen -W "--list --full --force" -- "$cur") ) ;;
	    ls)          COMPREPLY=( $(compgen -W "--all --names" -- "$cur") ) ;;
	    # Everything else — including every project command — takes a workspace.
	    *)           [ "$COMP_CWORD" -eq 2 ] \
	                   && COMPREPLY=( $(compgen -W "$(para ls --names 2>/dev/null)" -- "$cur") ) ;;
	  esac
	}
	complete -F _para para
	EOF
}

cmd_version() {
  sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$(pkg_root)/package.json" | head -1
}

# ---- dispatch --------------------------------------------------------------
main() {
  load_config
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    up)          cmd_up "$@" ;;
    down)        cmd_down "$@" ;;
    rm)          cmd_rm "$@" ;;
    ls)          cmd_ls "$@" ;;
    sh)          cmd_sh "$@" ;;
    caddy)       cmd_caddy "$@" ;;
    config)      cmd_config "$@" ;;
    image)       cmd_image "$@" ;;
    init)        cmd_init "$@" ;;
    doctor)      cmd_doctor "$@" ;;
    commands)    project_commands ;;
    completions) cmd_completions "$@" ;;
    ""|-h|--help|help) usage ;;
    --version)   cmd_version ;;
    # para wraps `incus exec`, so container muscle memory reaches for this.
    exec)        die "no 'exec' command — run one command in a workspace with: para sh <name> -c '<command>'" ;;
    *)           run_project_command "$cmd" "$@" ;;
  esac
}

main "$@"
