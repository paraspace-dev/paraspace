#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# para - parallel dev workspaces on Incus.
#
# Each workspace is an unprivileged Incus container with its own clone, its own
# stack, a static bridge IP, and an https:// URL served by a para-owned Caddy.
#
# This file is the generic mechanism and nothing else: everything a project
# needs done lives in that project's .paraspace/ dir (env, stack, layers/),
# which para runs but never contains.
#
# The prose lives in docs/ (env.md, layers.md, hooks.md, commands.md,
# image.md, urls.md, how-it-works.md, versioning.md). It is not restated here.
# ============================================================================

CT_PREFIX=para-

# The para<->project contract this engine implements: the injected env, the hook
# names and semantics, the ~/.paraspace layout in the guest, the env and stack
# files, and the layer-command mechanism. A breaking change to any of them bumps
# it; additive changes don't. A project declares the one it targets as
# PARA_CONTRACT and para refuses on a mismatch. See docs/versioning.md.
CONTRACT=1

# The oldest incus para is known to work with. It reads every workspace out of
# incus in one query, using config keys and device keys as `incus list` columns;
# an incus too old for that rejects the column outright. Ubuntu's apt repos
# still ship 6.2, which is too old.
MIN_INCUS=6.22

# The columns every workspace reader below expects, in order. Routes go LAST:
# they are space-separated by construction, but a stamp left by an older para
# may hold commas, and `read` puts whatever remains of the line in the final
# field, so a legacy value arrives intact instead of shifting the others.
WS_COLS='n,s,user.para.project,user.para.domain,devices:eth0.ipv4.address,user.para.routes'

# Prefixed to every command para runs inside a workspace. Everything the guest
# needs is already in the guest, so nothing is spliced in from the host except
# the caller's own command, appended verbatim.
# shellcheck disable=SC2016  # the guest expands these, not us
GUEST_PRELUDE='
  [ -f ~/.paraspace/env ] && . ~/.paraspace/env
  infocmp "${TERM:-}" >/dev/null 2>&1 || export TERM=xterm-256color
  cd "$HOME/${PARA_CLONE_DIR:-}" 2>/dev/null || cd "$HOME"
'

# ---- output ----------------------------------------------------------------
# stage, info, warn, die, interactive and pause come from $HELPERS, sourced by
# main, so the host prints what a hook prints.
need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }

# ---- configuration ---------------------------------------------------------
# Two sourced bash files, one idiom:
#
#   : "${PARA_X:=value}"   yields to the environment
#   PARA_X=value           insists
#
# so precedence is environment > user config > project env > the defaults at
# the bottom of load_config. Nothing below implements that; bash does.
load_config() {
  PARA_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/para"
  PARA_CONFIG="$PARA_CONFIG_DIR/config"
  PARA_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/para"
  CADDYFILE="$PARA_STATE_DIR/Caddyfile"
  CADDY_PID="$PARA_STATE_DIR/caddy.pid"
  CADDY_LOG="$PARA_STATE_DIR/caddy.log"
  # shellcheck disable=SC2034  # read by para_env's ${!PARA_@}, so a project
  # command can call back into para without relying on $PATH.
  PARA_BIN="$(cd "$(dirname "$0")" && pwd)/${0##*/}"

  # The project para operates on: the nearest .paraspace/ from $PWD upward,
  # like git and compose find theirs. Only a file locator, because a project's
  # identity is PARA_PROJECT_NAME, so moving the checkout never orphans a workspace.
  PARA_PROJECT_DIR="${PARA_PROJECT_DIR:-$(find_project_root || true)}"
  # shellcheck source=/dev/null  # a per-user and a per-project file, both runtime
  if [ -f "$PARA_CONFIG" ]; then . "$PARA_CONFIG"; fi
  # shellcheck source=/dev/null
  if [ -f "$PARA_PROJECT_DIR/.paraspace/env" ]; then . "$PARA_PROJECT_DIR/.paraspace/env"; fi

  # Engine-owned on both host and guest, and reasserted after the two files
  # above so a config cannot point commands at a replacement for it.
  # shellcheck disable=SC2154  # main sets $HELPERS before it calls this
  export PARA_HELPERS="$HELPERS"

  : "${PARA_DOMAIN:=paraspace.dev}"
  : "${PARA_HTTPS_PORT:=8443}"
  : "${PARA_POOL:=default}"
  : "${PARA_BRIDGE:=incusbr0}"
  : "${PARA_IP_LO:=200}"
  : "${PARA_IP_HI:=249}"
  : "${PARA_USER:=app}"
  : "${PARA_UID:=1000}"
  : "${PARA_GID:=1000}"
  : "${PARA_CLONE_DIR:=app}"
  : "${PARA_CLONE_BRANCH:=}"
  # The repo a hook clones, read off the checkout para found, the way
  # PARA_PROJECT_NAME is read off its directory name.
  : "${PARA_ORIGIN:=$(git_origin "$PARA_PROJECT_DIR")}"
  # What `para image build` builds from, and the line that leaves bash in the
  # builder for it. The bootstrap defaults only when UNSET, so a base that needs
  # nothing keeps the PARA_IMAGE_BOOTSTRAP="" that says so.
  : "${PARA_IMAGE_BASE:=images:voidlinux}"
  : "${PARA_IMAGE_BOOTSTRAP=$(default_bootstrap "$PARA_IMAGE_BASE")}"
  # Guest DNS comes up a beat after the container, so hooks wait on one name
  # resolving. para's own, so the default presumes nothing about your git host.
  # `=` not `:=`, so PARA_READY_HOST="" survives as the off switch.
  : "${PARA_READY_HOST=paraspace.dev}"
  # Caddy's admin endpoint. Empty means Caddy's own default (localhost:2019),
  # which every Caddy on the box shares. Set this to give para's Caddy an
  # address of its own when something else is already using it.
  : "${PARA_CADDY_ADMIN:=}"
  : "${PARA_WORKCOPY_HOST:=localhost}"
  : "${PARA_WORKCOPY_PORT:=}"
  # Identity, and the three names derived from it. Deriving PARA_IMAGE_NAME per
  # project matters: incus image aliases are daemon-global, so a fixed default
  # would have one project's build republish another's image.
  : "${PARA_PROJECT_NAME:=$(slug "${PARA_PROJECT_DIR##*/}")}"
  : "${PARA_IMAGE_NAME:=$PARA_PROJECT_NAME}"
  : "${PARA_VOLUME:=para-home-$PARA_PROJECT_NAME}"
  : "${PARA_HOST_ENV:=$PARA_PROJECT_DIR/.env}"
  PARA_ROUTES="$(normalize_routes "${PARA_ROUTES:-}")"
  PARA_SHARED=/para/shared
  # What the project targets, if it said. Never para's own number: by the time a
  # hook runs, require_project has already refused a mismatch, so the two are
  # equal and injecting ours would say nothing a hook doesn't know.
  : "${PARA_CONTRACT:=}"
  # Derived from the stack file on every invocation, so a declaration in env
  # cannot override it: host paths here, guest paths in the guest.
  PARA_STACK="$(stack_load)"
}

find_project_root() {
  local dir="$PWD"
  while [ "$dir" != / ]; do
    if [ -d "$dir/.paraspace" ]; then printf '%s' "$dir"; return; fi
    dir="$(dirname "$dir")"
  done
  return 1
}

# A directory name as a project slug: lowercase, everything else a hyphen.
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-'; }

# The origin of a checkout, when it is one and has one. An absent git, repo or
# remote is all the same answer, no origin, and the hook that needs one refuses.
git_origin() { # git_origin <dir>
  [ -n "$1" ] || return 0
  git -C "$1" remote get-url origin 2>/dev/null || true
}

# One `sh -c` line leaving bash in the builder, for the bases para recognizes.
# Void's also refreshes its bundled xbps, a rolling snapshot too stale to install
# against. Any other base declares its own, and Debian's family ships bash.
default_bootstrap() { # default_bootstrap <image>
  case "$1" in
    *voidlinux*) printf 'xbps-install -Syu xbps bash' ;;
    *alpine*)    printf 'apk add --no-cache bash' ;;
  esac
}

# Routes may be written with commas, spaces, tabs or newlines. The canonical
# form is lowercase and space-separated, what para stamps on the container,
# injects as $PARA_ROUTES, and reads back with plain word splitting. Also used
# on the way back out of incus, where a stamp made by an older para may still
# be comma-separated and therefore CSV-quoted.
normalize_routes() {
  local routes
  routes="$(printf '%s' "$1" | tr -d '"' | tr ',\t\n' '   ' | tr -s ' ' | tr '[:upper:]' '[:lower:]')"
  routes="${routes# }"          # -s left at most one space at each edge
  printf '%s' "${routes% }"
}

# Commands that clone, boot or build need a project; the rest work anywhere.
# Stack resolution happens here too, once, up front, so nothing downstream
# touches a workspace before every layer is known to exist.
require_project() {
  [ -n "$PARA_PROJECT_DIR" ] \
    || die "not inside a para project: no .paraspace/ directory from \$PWD upward. cd into one, or set PARA_PROJECT_DIR."
  if [ -n "$PARA_CONTRACT" ] && [ "$PARA_CONTRACT" != "$CONTRACT" ]; then
    die "this project targets para contract $PARA_CONTRACT, but this para provides $CONTRACT. See docs/versioning.md."
  fi
  stack_check
}

# ---- the stack -------------------------------------------------------------
# The stack file is the project's layer list: one directory path per line,
# resolved against the project root, composed top to bottom. Blank lines and
# #-comment lines are ignored. docs/layers.md.

# The stack file, normalized: comments and blanks dropped, whitespace and
# trailing slashes trimmed. The slashes matter: a layer name ending in '/'
# lands the guest copy at one path and advertises another, so its hooks
# silently never run.
stack_lines() {
  local file="$PARA_PROJECT_DIR/.paraspace/stack"
  [ -f "$file" ] || return 0
  awk '{ gsub(/^[ \t]+|[ \t]+$/, "") } $0 == "" || $0 ~ /^#/ { next } { gsub(/\/+$/, ""); print }' "$file"
}

# The normalized lines resolved against the project root, which is what
# load_config puts in $PARA_STACK.
stack_load() {
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      /*) printf '%s\n' "$line" ;;
      *)  printf '%s\n' "$PARA_PROJECT_DIR/$line" ;;
    esac
  done < <(stack_lines)
}

# Every layer directory in the stack, in order. The one iteration source for
# hooks, commands and the pushes below.
stack_dirs() {
  [ -n "$PARA_STACK" ] || return 0
  printf '%s\n' "$PARA_STACK"
}

# The one name a layer goes by: its stack line with the known roots stripped,
# so a bundled layer keeps its catalog name ('docker', 'base/void'), a
# plugin's carries its vendor ('acme/mod-a'), and anything else keeps its
# last path component. It is also the layer's directory name in the guest,
# which is why stack_check refuses two layers that share one.
layer_name() { # layer_name <resolved-dir>
  local rel="${1#"$PARA_PROJECT_DIR"/}" vendor
  case "$rel" in
    node_modules/paraspace/layers/*) printf '%s\n' "${rel#node_modules/paraspace/layers/}" ;;
    node_modules/paraspace-plugin-*/layers/*)
      vendor="${rel#node_modules/paraspace-plugin-}"
      printf '%s/%s\n' "${vendor%%/*}" "${rel#*/layers/}" ;;
    .paraspace/layers/*) printf '%s\n' "${rel#.paraspace/layers/}" ;;
    *) printf '%s\n' "${rel##*/}" ;;
  esac
}

stack_names() {
  local dir
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    layer_name "$dir"
  done < <(stack_dirs)
}

# The two collisions the engine cannot compose, as emitters, so stack_check
# can refuse on them and doctor_stack can report them off the same facts.
stack_dupe_lines() { stack_dirs | sort | uniq -d; }
stack_dupe_names() { stack_names | sort | uniq -d; }

# Refuse a stack the engine cannot compose: the same line twice, two layers
# that materialize under one guest name, or a directory that is not there.
# Every problem in one report, so one fix round covers them all.
stack_check() {
  [ -n "$PARA_STACK" ] || return 0
  local dupes missing="" dir
  dupes="$(stack_dupe_lines)"
  [ -z "$dupes" ] || die "duplicate stack lines in .paraspace/stack:
$dupes"
  dupes="$(stack_dupe_names)"
  [ -z "$dupes" ] || die "two stack lines share a layer name ($(printf '%s' "$dupes" | tr '\n' ' ')). Rename one, or point one line at a copy under .paraspace/layers/."
  while IFS= read -r dir; do
    if [ ! -d "$dir" ]; then missing="${missing:+$missing
}  ${dir#"$PARA_PROJECT_DIR"/}"; fi
  done < <(stack_dirs)
  [ -z "$missing" ] || die "stack layers missing on disk:
$missing
Run 'npm install' if these live under node_modules/, else fix .paraspace/stack."
}

# Every PARA_* in scope, as export lines. This is the one way para hands its
# context to anything it runs for you: guest hooks, project commands, and the
# image builder. A key you invent in your env file reaches all three.
para_env() {
  local var
  for var in "${!PARA_@}"; do printf 'export %s=%q\n' "$var" "${!var}"; done
}

validate_name() {
  [[ "$1" =~ ^[a-z][a-z0-9-]{0,30}$ ]] \
    || die "invalid workspace name '$1'. Use lowercase letters, digits and hyphens, starting with a letter (max 31)."
}

# ---- URLs ------------------------------------------------------------------
# The ":port" para URLs carry, empty on :443.
url_port() { [ "$PARA_HTTPS_PORT" = 443 ] || printf ':%s' "$PARA_HTTPS_PORT"; }

# "[sub:]port" -> the Caddy site host for <workspace> on <domain>.
route_host() { # route_host <route> <name> <domain>
  case "$1" in
    *:*) printf '%s.%s.%s' "${1%%:*}" "$2" "$3" ;;
    *)   printf '%s.%s' "$2" "$3" ;;
  esac
}

# The apex URL, empty unless a bare port routes it. A subdomain-only project
# has no site at https://<name>.<domain>, so there is nothing to print.
ws_url() { # ws_url <name> <domain> <routes>
  local route
  # shellcheck disable=SC2086  # routes are space-separated by construction
  for route in $3; do
    case "$route" in *:*) continue ;; esac
    printf 'https://%s.%s%s' "$1" "$2" "$(url_port)"
    return
  done
}

# Every URL a workspace publishes, one per line.
ws_urls() { # ws_urls <name> <domain> <routes>
  local route
  # shellcheck disable=SC2086  # routes are space-separated by construction
  for route in $3; do
    printf 'https://%s%s\n' "$(route_host "$route" "$1" "$2")" "$(url_port)"
  done
}

# ---- incus is the registry -------------------------------------------------
# A workspace records its own project, routes and domain in its container's
# user config, and its IP in its eth0 device. incus can return all of it in one
# query, so para keeps no registry of its own and can't drift from one.
ws_list() { # ws_list [<project>] -> CSV: name,state,project,domain,ip,routes
  if [ -n "${1:-}" ]; then
    incus list "^$CT_PREFIX" "user.para.project=$1" -f csv -c "$WS_COLS"
  else
    incus list "^$CT_PREFIX" -f csv -c "$WS_COLS"
  fi
}

# Load workspace <name> into ws_state/ws_project/ws_domain/ws_ip/ws_routes.
# Non-zero if there is no such workspace.
ws_load() {
  local rows row
  rows="$(ws_list)" || die "cannot read the workspace list from incus. Refusing to guess whether '$1' exists."
  row="$(awk -F, -v ct="$CT_PREFIX$1" '$1 == ct' <<<"$rows")"
  [ -n "$row" ] || return 1
  # shellcheck disable=SC2034  # a row reader exposes the whole row, used or not
  IFS=, read -r _ ws_state ws_project ws_domain ws_ip ws_routes <<<"$row"
  ws_routes="$(normalize_routes "$ws_routes")"
}

instance_exists() { incus info "$1" >/dev/null 2>&1; }

# incus's carriage-return progress bars are noise once captured to a file.
incus_q() { if [ -t 2 ]; then incus "$@"; else incus --quiet "$@"; fi; }

require_incus() {
  need incus
  incus info >/dev/null 2>&1 \
    || die "incus is not reachable. Start it (on macOS, colima start --runtime incus), then try 'para doctor'."
}

# Mirror this workspace's identity onto its container, refreshed on every up.
stamp_ct() { # stamp_ct <ct>
  incus config set "$1" \
    "user.para.project=$PARA_PROJECT_NAME" \
    "user.para.domain=$PARA_DOMAIN" \
    "user.para.routes=$PARA_ROUTES"
}

# NOTE, and it applies to every helper reached from inside a $( ): bash strips
# `set -e` there, so a `die` in one of them kills only the substitution and the
# caller sails on with an empty value. Such helpers RETURN non-zero and the
# caller checks. See alloc_ip.
bridge_prefix() { # "192.168.100.1/24" -> "192.168.100"
  local addr
  addr="$(incus network get "$PARA_BRIDGE" ipv4.address 2>/dev/null)" || return 1
  [ -n "$addr" ] || return 1
  addr="${addr%/*}"
  printf '%s' "${addr%.*}"
}

# A free static IP in the bridge's <prefix>.$PARA_IP_LO-$PARA_IP_HI band. Reads
# the addresses incus has actually pinned, across all incus projects, since the
# bridge is machine-global, so anything else fails open onto a live container.
alloc_ip() {
  local prefix used n
  prefix="$(bridge_prefix)" \
    || die "cannot read $PARA_BRIDGE ipv4.address. Is the bridge up? ('para doctor')"
  # Two sources, because neither is complete: the runtime address (empty while an
  # instance is stopped) and the pinned device address (absent on instances para
  # did not create). Reduced to bare addresses, because incus annotates the runtime
  # column as "10.0.0.5 (eth0)", and a whole-line match would miss every one.
  used="$(incus list --all-projects -f csv -c '4,devices:eth0.ipv4.address' \
    | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}')"
  for n in $(seq "$PARA_IP_LO" "$PARA_IP_HI"); do
    if ! grep -qxF "$prefix.$n" <<<"$used"; then printf '%s' "$prefix.$n"; return; fi
  done
  return 1   # the caller dies; a die here is inside a $( ). See bridge_prefix
}

# The shared home volume: one authenticated home per project, attached to every
# workspace of it. security.shifted is what lets a single volume attach to many
# unprivileged containers with correctly shifted ownership. Do not drop it.
ensure_volume() {
  if incus storage volume show "$PARA_POOL" "$PARA_VOLUME" >/dev/null 2>&1; then return; fi
  stage "Creating shared volume '$PARA_VOLUME' on pool '$PARA_POOL'…"
  incus storage volume create "$PARA_POOL" "$PARA_VOLUME" security.shifted=true
}

attach_volume() { # attach_volume <ct>
  local devices
  devices="$(incus config device show "$1")"
  case "$devices" in *parahome:*) return ;; esac
  incus storage volume attach "$PARA_POOL" "$PARA_VOLUME" "$1" parahome "$PARA_SHARED"
}

# Block until the guest can actually be provisioned: the incus agent answers,
# and guest DNS resolves $PARA_READY_HOST, unless that is empty.
wait_ready() { # wait_ready <ct>
  stage "Waiting for $1…"
  for _ in $(seq 1 60); do
    if incus exec "$1" -- true 2>/dev/null; then
      [ -n "$PARA_READY_HOST" ] || return 0
      if incus exec "$1" -- getent hosts "$PARA_READY_HOST" >/dev/null 2>&1; then return 0; fi
    fi
    sleep 2
  done
  die "$1 was not ready in ~120s (agent, or guest DNS for '$PARA_READY_HOST'). Check: incus info --show-log $1"
}

# ---- Caddy -----------------------------------------------------------------
# True only if OUR Caddy is running. The pidfile survives a reboot, so kill -0
# alone can match an unrelated process that inherited the PID.
caddy_running() {
  [ -f "$CADDY_PID" ] || return 1
  local pid
  pid="$(cat "$CADDY_PID")"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  case "$(ps -p "$pid" -o comm= 2>/dev/null)" in *caddy*) return 0 ;; *) return 1 ;; esac
}

# Caddy narrates every invocation in structured JSON on stderr, success or
# not, so its output goes to a log and is surfaced only when something failed.
# The started daemon inherits the same file, which is what makes $CADDY_LOG
# worth keeping around rather than a temp file.
caddy_run() { # caddy_run <args>…
  if caddy "$@" >>"$CADDY_LOG" 2>&1; then return; fi
  tail -n 20 "$CADDY_LOG" >&2
  return 1
}

caddy_globals() {
cat <<EOF
{
	# Internal CA only, so no ACME and nothing needs to bind :80.
	auto_https disable_redirects
${PARA_CADDY_ADMIN:+	admin $PARA_CADDY_ADMIN
}}
EOF
}

# Optional passthrough so a stack you run on the HOST keeps its familiar URL.
# If that stack terminates TLS with SNI, dial it by name so the handshake matches.
caddy_workcopy() {
  [ -n "$PARA_WORKCOPY_PORT" ] || return 0
cat <<EOF

# Working copy passthrough.
https://localhost$(url_port), https://local.$PARA_DOMAIN$(url_port) {
	reverse_proxy https://127.0.0.1:$PARA_WORKCOPY_PORT {
		header_up Host $PARA_WORKCOPY_HOST
		transport http {
			tls_server_name $PARA_WORKCOPY_HOST
			tls_insecure_skip_verify
		}
	}
	tls internal
}
EOF
}

# One site per route, for every para workspace on this machine, each served by
# ITS OWN recorded domain and routes, so one Caddy is correct across projects.
caddy_sites() {
  local rows name state project domain ip routes route ws
  # Captured, not piped in from a process substitution: a failed query there is
  # indistinguishable from "no workspaces", and the config that gets written is
  # a valid one with every route on the machine missing.
  rows="$(ws_list)" \
    || die "cannot read the workspace list from incus. Refusing to write a Caddyfile that would drop every route."
  while IFS=, read -r name state project domain ip routes; do
    ws="${name#"$CT_PREFIX"}"
    routes="$(normalize_routes "$routes")"
    if [ -z "$project" ] || [ -z "$ip" ] || [ -z "$routes" ]; then continue; fi
    printf '\n# workspace %s (%s)\n' "$ws" "$project"
    # shellcheck disable=SC2086  # routes are space-separated by construction
    for route in $routes; do
      printf 'https://%s%s {\n\treverse_proxy %s:%s\n\ttls internal\n}\n\n' \
        "$(route_host "$route" "$ws" "$domain")" "$(url_port)" "$ip" "${route##*:}"
    done
  done <<<"$rows"
}

# Regenerate the Caddyfile from incus and make Caddy adopt it, starting Caddy
# if it isn't running, which is what a bare `para up` relies on. `caddy
# validate` is the route validator: it catches a bad port or two workspaces
# claiming one hostname, and says which, before anything is live.
caddy_sync() {
  need caddy
  mkdir -p "$PARA_STATE_DIR"
  # Into place only once it is complete: `>` truncates on open, so generating
  # straight into $CADDYFILE would leave a gutted one behind on any failure.
  { caddy_globals; caddy_workcopy; caddy_sites; } > "$CADDYFILE.new"
  caddy_run validate --config "$CADDYFILE.new" --adapter caddyfile \
    || die "the generated Caddyfile is invalid (above). Check PARA_ROUTES and PARA_DOMAIN. It is at $CADDYFILE.new."
  mv "$CADDYFILE.new" "$CADDYFILE"
  if caddy_running; then
    caddy_run reload --config "$CADDYFILE" --adapter caddyfile \
      || die "caddy refused the new config (above); the full log is $CADDY_LOG."
    return
  fi
  stage "Starting para Caddy on :${PARA_HTTPS_PORT}…"
  rm -f "$CADDY_PID"
  caddy_run start --config "$CADDYFILE" --adapter caddyfile --pidfile "$CADDY_PID" \
    || die "caddy could not start on :$PARA_HTTPS_PORT (above). 'para doctor' checks the usual causes, and the full log is $CADDY_LOG."
  warn "If browsers distrust the certificates, run once:  caddy trust"
}

# ---- the one door into a workspace -----------------------------------------
# Every guest execution goes through here (`para sh`, hooks, and, via `para
# sh`, project commands), so the terminal handling is stated once:
#
#   su -       runs initgroups, so the user's supplementary groups load. That
#              is why this is not `incus exec --user`: without the docker group
#              the stack hits permission denied on the socket.
#   su --pty   with -c, plain su stays the terminal's foreground process and
#              drops SIGWINCH, so a TUI never repaints on resize. --pty proxies
#              the tty and forwards resizes to the child. (util-linux su only;
#              busybox has no --pty, so an interactive shell needs a real one.)
#   -t / -T    a pty only when BOTH our ends are terminals. A pty echoes NULs
#              and turns \n into \r\n, so forcing one on stdin alone dirties
#              `para sh x -c … | tee`, `> file` and `$(…)`. Explicit in both
#              directions, because incus's auto mode ignores PARA_NONINTERACTIVE.
#   -s bash    deterministic semantics for -c, whatever login shell the image
#              gives $PARA_USER. Hooks get bash from run-hook instead.
ws_exec() { # ws_exec <name> [<command>]
  local ct="$CT_PREFIX$1"
  if [ "$#" -lt 2 ]; then
    incus exec "$ct" -t -- su - "$PARA_USER"
  elif interactive; then
    incus exec "$ct" -t -- su --pty - "$PARA_USER" -s /bin/bash -c "$GUEST_PRELUDE$2"
  else
    incus exec "$ct" -T -- su - "$PARA_USER" -s /bin/bash -c "$GUEST_PRELUDE$2"
  fi
}

# ---- hooks -----------------------------------------------------------------
# $PARA_STACK as the guest sees it: the same layers, in the same order, where
# push_stack puts them under <dest>.
guest_stack() { # guest_stack <dest>
  local dir
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    printf '%s/.paraspace/stack/%s\n' "$1" "$(layer_name "$dir")"
  done < <(stack_dirs)
}

# para_env as the guest sees it: the path keys renamed to where <dest>
# actually put them, and the ones that must not cross unset rather than left
# pointing at host files.
guest_env() { # guest_env <dest>
  # Local, because the host keeps its own PARA_HOST_ENV, which push_project reads.
  # shellcheck disable=SC2034  # all three are read by para_env's ${!PARA_@}
  local PARA_HOST_ENV="$1/.paraspace/host.env" \
        PARA_HELPERS="$1/.paraspace/helpers" \
        PARA_STACK
  PARA_STACK="$(guest_stack "$1")"
  para_env
  # para_env forwards every PARA_* in scope, including whatever the caller
  # happened to export. PARA_HOOK_CHAIN is the runner's to build from empty:
  # inherited, it reads as "we are already inside that hook" and every run
  # trips the cycle guard instead of running anything. PARA_LAYER_DIR is
  # per-hook and per-command, never ambient.
  printf 'unset PARA_BIN PARA_PROJECT_DIR PARA_CONFIG PARA_CONFIG_DIR PARA_STATE_DIR PARA_HOOK_CHAIN PARA_LAYER_DIR\n'
}

# Replace <instance>:<dest>/.paraspace with the composed stack, plus para's
# context. The rm is what makes it a replace: `incus file push -r` merges into
# whatever is already there, so a layer you dropped would otherwise survive in
# the guest.
push_stack() { # push_stack <instance> <dest>
  local dir name parent
  incus exec "$1" -- rm -rf "$2/.paraspace"
  incus exec "$1" -- mkdir -p "$2/.paraspace/stack"
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    # Each layer lands at stack/<layer name>; the name's last component is the
    # directory's own basename, which is what `file push -r` creates.
    name="$(layer_name "$dir")"
    parent="$2/.paraspace/stack"
    # Only a nested name ('base/void') needs a parent the mkdir above did not
    # already make; skipping the exec otherwise saves a daemon round-trip per layer.
    case "$name" in
      */*) parent="$parent/${name%/*}"; incus exec "$1" -- mkdir -p "$parent" ;;
    esac
    incus_q file push -r "$dir" "$1$parent/"
  done < <(stack_dirs)
  # The push carries your checkout's own modes, so a `umask 077` tree lands
  # 0700 and a build hook that steps down to $PARA_USER can't read its own
  # layer. Before the env push, which keeps the 0600 it is given.
  incus exec "$1" -- chmod -R a+rX "$2/.paraspace"
  guest_env "$2" | incus_q file push --mode 0600 - "$1$2/.paraspace/env"
  # After the tree, so a layer shipping its own run-hook can't shadow para's.
  # The helpers follow for the same reason. Both the workspace and the builder
  # run hooks through these files.
  incus_q file push --mode 0755 "$(pkg_root)/libexec/run-hook" "$1$2/.paraspace/run-hook"
  incus_q file push --mode 0644 "$(pkg_root)/libexec/helpers" "$1$2/.paraspace/helpers"
}

# The workspace's copy: the stack, plus the project's base .env and the user's
# ownership of it. Fresh on every up, so an edit to a hook takes effect without
# re-cloning anything.
push_project() { # push_project <name>
  local ct="$CT_PREFIX$1" home="/home/$PARA_USER"
  push_stack "$ct" "$home"
  if [ -f "$PARA_HOST_ENV" ]; then
    incus_q file push --mode 0600 "$PARA_HOST_ENV" "$ct$home/.paraspace/host.env"
  fi
  incus exec "$ct" -- chown -R "$PARA_UID:$PARA_GID" "$home/.paraspace"
}

# Run <hook> from every layer that defines it, in stack order. The runner
# announces what it finds, because only it knows how many that is. Hooks own
# all provisioning; para only decides when they run. docs/hooks.md.
run_hook() { # run_hook <hook> <name>
  ws_exec "$2" "exec ~/.paraspace/run-hook '$1'" || die "the '$1' hook failed (above)."
}

# Does any layer fill <hook>? Resolution is the runner's job, but refusing is
# the host's: the runner's note prints inside a container, minutes in, and the
# caller has already committed by then.
have_hook() { # have_hook <hook>
  local dir
  while IFS= read -r dir; do
    if [ -f "$dir/hooks/$1" ]; then return 0; fi
  done < <(stack_dirs)
  return 1
}

# The per-workspace half of the hook environment. Everything else a hook sees
# is already a PARA_* in scope, and para_env forwards them all.
# shellcheck disable=SC2034  # every one of these is read by para_env's ${!PARA_@}
workspace_context() { # workspace_context <name>
  PARA_NAME="$1"
  PARA_URL="$(ws_url "$1" "$PARA_DOMAIN" "$PARA_ROUTES")"
  PARA_HOSTNAME="$(hostname -s 2>/dev/null || hostname)"
  PARA_GIT_NAME="$(git config --global user.name 2>/dev/null || true)"
  PARA_GIT_EMAIL="$(git config --global user.email 2>/dev/null || true)"
}

# ---- workspace lifecycle ---------------------------------------------------
# On a failed `up`, point at the one command that knows how a host misbehaves.
up_hint() { [ "$1" -eq 0 ] || warn "if that reads like a host problem rather than a project one, run: para doctor"; }

cmd_up() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: para up <name>"
  validate_name "$name"
  require_project
  require_incus
  # Container names are machine-global, so refuse to adopt another project's.
  # An unstamped container has no owner (a launch that failed before stamp_ct,
  # or one made by hand), so it is adoptable. Only a DIFFERENT owner refuses.
  if ws_load "$name" && [ -n "$ws_project" ] && [ "$ws_project" != "$PARA_PROJECT_NAME" ]; then
    die "workspace '$name' belongs to project '$ws_project'. Names are unique per machine, so pick another."
  fi
  trap 'up_hint $?' EXIT

  local ct="$CT_PREFIX$name" ip
  if instance_exists "$ct"; then
    # Only start it when it isn't running: a blanket `|| true` here would also
    # swallow the real reason a stopped workspace refuses to come up, and the
    # next thing the user sees is a 120s wait_ready timeout blaming guest DNS.
    if [ "${ws_state:-}" = RUNNING ]; then
      stage "Workspace '$name' is running, reconverging…"
    else
      stage "Workspace '$name' exists, starting it…"
      incus start "$ct"
    fi
  else
    incus image info "$PARA_IMAGE_NAME" >/dev/null 2>&1 \
      || die "no image '$PARA_IMAGE_NAME'. Build it first with 'para image build'."
    ip="$(alloc_ip)" \
      || die "no free IP in the .$PARA_IP_LO-.$PARA_IP_HI band on $PARA_BRIDGE. Remove a workspace, or widen PARA_IP_LO/HI."
    stage "Launching $ct at ${ip}…"
    incus launch "$PARA_IMAGE_NAME" "$ct" --storage "$PARA_POOL" \
      -c security.nesting=true -d eth0,ipv4.address="$ip"
    # Immediately, before anything that can fail: an unstamped container has no
    # owner, and everything downstream (ls, the up/rm guards) works off the
    # stamp. Refreshed below on the reconverge path.
    stamp_ct "$ct"
  fi
  ensure_volume
  attach_volume "$ct"
  stamp_ct "$ct"
  wait_ready "$ct"
  # A fresh volume's root is root-owned; para owns the volume, so para makes it
  # writable before the (unprivileged) provision hook seeds it.
  incus exec "$ct" -- chown "$PARA_UID:$PARA_GID" "$PARA_SHARED"

  workspace_context "$name"
  push_project "$name"
  run_hook provision "$name"
  stage "Booting. The first run pulls images, so be patient…"
  run_hook boot "$name"
  caddy_sync
  trap - EXIT
  local urls
  urls="$(ws_urls "$name" "$PARA_DOMAIN" "$PARA_ROUTES" | tr '\n' ' ')"
  if [ -n "$urls" ]; then
    stage "Workspace '$name' ready → $urls"
  else
    stage "Workspace '$name' ready. It declares no HTTP routes, so use 'para sh $name' for a shell."
  fi
}

cmd_down() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: para down <name>"
  require_incus
  ws_load "$name" || die "no such workspace '$name' (see: para ls)"
  if [ -n "$ws_project" ] && [ "$ws_project" != "$PARA_PROJECT_NAME" ]; then
    die "workspace '$name' belongs to project '$ws_project'. Stop it from there, or run: PARA_PROJECT_NAME=$ws_project para down $name"
  fi
  if [ "$ws_state" != RUNNING ]; then
    warn "workspace '$name' is already stopped"
    return
  fi
  incus stop "$CT_PREFIX$name"
  stage "Workspace '$name' stopped. Data is kept, and 'para up $name' resumes it."
}

cmd_rm() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: para rm <name>"
  validate_name "$name"
  require_incus
  local ct="$CT_PREFIX$name"
  # Names are machine-global and `para ls` is project-scoped, so without this a
  # workspace you cannot even see is one typo away from being destroyed. `up`
  # refuses the same way; this is the destructive half of the pair.
  # Same as `up`: only a different OWNER refuses. An unstamped container must
  # stay removable, or a workspace whose launch died before stamp_ct could never
  # be cleaned up with para at all.
  if ws_load "$name" && [ -n "$ws_project" ] && [ "$ws_project" != "$PARA_PROJECT_NAME" ]; then
    die "workspace '$name' belongs to project '$ws_project'. Remove it from there, or run: PARA_PROJECT_NAME=$ws_project para rm $name"
  fi
  # Converging on "gone", so an already-absent workspace is a no-op. Teardown
  # scripts rely on that, and it is still said out loud in case of a typo.
  if ! instance_exists "$ct"; then
    warn "no workspace '$name' to remove (see: para ls)"
    return
  fi
  stage "Deleting ${ct}…"
  incus delete -f "$ct"
  # Only if it is already up: starting Caddy is `up`'s job, and a `rm` should
  # neither resurrect one you stopped nor fail on a host without caddy at all.
  if caddy_running; then caddy_sync; fi
  stage "Removed workspace '$name'. The shared volume is untouched."
}

cmd_ls() {
  local all=0 names=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -a|--all) all=1; shift ;;
      --names)  names=1; shift ;;
      *) die "usage: para ls [-a|--all] [--names]" ;;
    esac
  done
  require_incus
  # Scoped to this project by default, and to everything when asked, or when
  # there is no project to scope to.
  local scope="$PARA_PROJECT_NAME"
  [ "$all" -eq 0 ] || scope=""

  local rows name state project domain ip routes ws
  rows="$(ws_list "$scope")" || die "cannot read the workspace list from incus."
  [ "$names" -eq 1 ] || printf '%-20s %-9s %-16s %-14s %s\n' NAME STATE IP PROJECT URL
  while IFS=, read -r name state project domain ip routes; do
    [ -n "$project" ] || continue
    ws="${name#"$CT_PREFIX"}"
    if [ "$names" -eq 1 ]; then
      printf '%s\n' "$ws"
    else
      printf '%-20s %-9s %-16s %-14s %s\n' "$ws" "$state" "$ip" "$project" \
        "$(ws_url "$ws" "$domain" "$(normalize_routes "$routes")")"
    fi
  done <<<"$rows"
}

cmd_sh() {
  local usage="usage: para sh <name> [-c <command>]  (the command as ONE quoted string)"
  local name="" cmd="" have_cmd=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -c) shift; [ "$#" -gt 0 ] || die "$usage"
          cmd="$1"; have_cmd=1; shift ;;
      -*) die "$usage" ;;
      *)  [ -z "$name" ] || die "unexpected argument: $1"
          name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "$usage"
  require_incus
  ws_load "$name" || die "no such workspace '$name' (see: para ls)"
  [ "$ws_state" = RUNNING ] || die "workspace '$name' is $ws_state. Run 'para up $name' first."
  if [ "$have_cmd" -eq 1 ]; then ws_exec "$name" "$cmd"; else ws_exec "$name"; fi
}

# ---- host side -------------------------------------------------------------
cmd_caddy() {
  case "${1:-}" in
    start)
      require_incus
      caddy_sync
      stage "para Caddy is up on :$PARA_HTTPS_PORT."
      ;;
    stop)
      # By pidfile, not `caddy stop`: that goes through the admin endpoint, which
      # several Caddys can share, so it might stop somebody else's. SIGTERM is a
      # graceful shutdown for Caddy anyway.
      if ! caddy_running; then stage "para Caddy is not running."; return; fi
      kill "$(cat "$CADDY_PID")"
      rm -f "$CADDY_PID"
      stage "para Caddy stopped. Workspaces keep running."
      ;;
    status)
      if caddy_running; then
        stage "para Caddy is running (pid $(cat "$CADDY_PID")) on :$PARA_HTTPS_PORT"
        stage "  config $CADDYFILE"
        stage "  log    $CADDY_LOG"
      else
        stage "para Caddy is not running. Start it with 'para caddy start'."
      fi
      ;;
    *) die "usage: para caddy <start|stop|status>" ;;
  esac
}

cmd_config() {
  case "${1:-}" in
    path) printf '%s\n' "$PARA_CONFIG" ;;
    edit)
      # Seeded on first use, so this is the only one of these anyone has to
      # know. $EDITOR is split deliberately: people set it with flags
      # ("code -w", "emacsclient -nw"), and quoting it would break them.
      if [ ! -f "$PARA_CONFIG" ]; then
        mkdir -p "$PARA_CONFIG_DIR"
        config_template > "$PARA_CONFIG"
      fi
      # shellcheck disable=SC2086  # see above
      exec ${VISUAL:-${EDITOR:-vi}} "$PARA_CONFIG"
      ;;
    init)
      if [ -f "$PARA_CONFIG" ] && [ "${2:-}" != --force ]; then
        die "$PARA_CONFIG already exists. Edit it, or 'para config init --force' to replace it."
      fi
      mkdir -p "$PARA_CONFIG_DIR"
      config_template > "$PARA_CONFIG"
      stage "Wrote $PARA_CONFIG. Every line is commented out; uncomment what you want to change."
      ;;
    *) die "usage: para config <edit|init [--force]|path>" ;;
  esac
}

# Generated from para's own resolved values, so the box-level knobs are listed
# in exactly one place and the seeded file can never drift from the defaults.
config_template() {
  local key
  cat <<-'EOF'
	# para user config, sourced as bash like a project's .paraspace/env.
	#
	#   : "${PARA_X:=value}"   yields to the environment
	#   PARA_X=value           insists
	#
	# This describes your BOX. Per-project settings (routes, image, origin…)
	# belong in the project's .paraspace/env. Nothing enforces that; `para
	# doctor` will tell you when a value here looks project-shaped.
	EOF
  for key in PARA_DOMAIN PARA_HTTPS_PORT PARA_CADDY_ADMIN PARA_POOL PARA_BRIDGE \
            PARA_IP_LO PARA_IP_HI PARA_WORKCOPY_HOST PARA_WORKCOPY_PORT \
            PARA_READY_HOST; do
    # shellcheck disable=SC2016  # the := idiom is the literal being written
    printf '# : "${%s:=%s}"\n' "$key" "${!key}"
  done
}

# ---- base image ------------------------------------------------------------
cmd_image() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    build)  cmd_image_build "$@" ;;
    status) cmd_image_status ;;
    rm)     cmd_image_rm ;;
    *) die "usage: para image <build [-i]|status|rm>" ;;
  esac
}

cmd_image_build() {
  require_project
  local from_current=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -i|--from-current) from_current=1; shift ;;
      *) die "usage: para image build [-i|--from-current]" ;;
    esac
  done
  # Everything the project itself has to get right, checked before the daemon,
  # because an incomplete project env is more useful to hear about than an absent
  # incus.
  have_hook image-build \
    || die "no 'image-build' hook in any layer. Write one at .paraspace/layers/project/hooks/image-build. See docs/image.md."
  local base="$PARA_IMAGE_BASE"
  [ "$from_current" -eq 0 ] || base="$PARA_IMAGE_NAME"

  require_incus
  if [ "$from_current" -eq 1 ]; then
    incus image info "$base" >/dev/null 2>&1 \
      || die "no existing '$base' image to build from. Run a plain 'para image build' first."
  fi

  # Script scope, not local: the EXIT trap fires after this function unwinds.
  builder="para-image-build-$PARA_PROJECT_NAME"
  tmp_alias="para-image-tmp-$PARA_PROJECT_NAME"
  published=0
  trap image_cleanup EXIT
  trap 'echo >&2; warn "interrupted, removing the builder…"; exit 130' INT TERM

  if instance_exists "$builder"; then incus delete -f "$builder"; fi
  stage "Launching the builder from '$base'…"
  incus_q launch "$base" "$builder" --storage "$PARA_POOL" -c security.nesting=true
  wait_ready "$builder"
  # The build hook runs under bash, and a minimal base may not ship it (or may
  # need its package index refreshed first). `sh` is the one interpreter every
  # base image has, which is what this line is for.
  if [ "$from_current" -eq 0 ] && [ -n "$PARA_IMAGE_BOOTSTRAP" ]; then
    stage "Bootstrapping the builder: $PARA_IMAGE_BOOTSTRAP"
    incus exec "$builder" -- sh -c "$PARA_IMAGE_BOOTSTRAP"
  fi
  # The builder gets the whole stack the way a workspace does, at /opt because
  # /root is 0700 and a build hook that steps down to $PARA_USER has to be
  # able to read its layer through it.
  incus exec "$builder" -- mkdir -p /opt
  push_stack "$builder" /opt
  stage "Provisioning the image. This takes a few minutes…"
  # Backgrounded so Ctrl-C works: incus relays SIGINT only into a process it
  # gave a pty, and this one has none. `wait` can be interrupted, which runs the
  # INT trap, which tears the builder down. Prompting is an `up`-only promise.
  incus exec "$builder" -- bash -c '. /opt/.paraspace/env; exec /opt/.paraspace/run-hook image-build' </dev/null &
  wait "$!"
  # image_publish snapshots the whole rootfs, and the project's tree is a build
  # input, not something every workspace should find lying around in its image.
  incus exec "$builder" -- rm -rf /opt/.paraspace
  image_publish "$base"
  # Before the traps are cleared, so an interrupt here is still covered.
  incus delete -f "$builder"
  trap - EXIT INT TERM
  stage "Image '$PARA_IMAGE_NAME' ready. Now: para up <name>"
}

# Stop, snapshot, publish to a temp alias, then swap. Each step is deliberate:
# a force-stop because a container init that ignores the shutdown signal never
# halts; a snapshot because publishing a just-stopped instance races its rootfs
# settling; a temp alias because publishing over the live alias would leave the
# box with no image at all if the publish failed.
image_publish() { # image_publish <base>
  incus stop -f "$builder"
  incus snapshot create "$builder" publish
  stage "Publishing as '$PARA_IMAGE_NAME'…"
  incus_q publish "$builder/publish" --reuse --alias "$tmp_alias"
  published=1
  incus image delete "$PARA_IMAGE_NAME" >/dev/null 2>&1 || true
  incus image alias rename "$tmp_alias" "$PARA_IMAGE_NAME" \
    || die "the new image is published as '$tmp_alias' but could not be renamed. Recover with: incus image alias rename $tmp_alias $PARA_IMAGE_NAME"
  # What this image was built from, as opposed to what the env names today,
  # which is what the *next* build would use. `-i` stamps $PARA_IMAGE_NAME itself.
  incus image set-property "$PARA_IMAGE_NAME" user.para.base "$1"
}

# Never delete the temp alias once it holds the only copy of the image.
image_cleanup() {
  [ "$published" -eq 1 ] || incus image delete "$tmp_alias" >/dev/null 2>&1 || true
  incus delete -f "$builder" >/dev/null 2>&1 || true
}

cmd_image_status() {
  require_project
  require_incus
  local info
  info="$(incus image info "$PARA_IMAGE_NAME" 2>/dev/null)" \
    || die "no '$PARA_IMAGE_NAME' image yet. Build it with: para image build"
  local built base
  built="$(awk -F'Uploaded: *' '/Uploaded:/{print $2; exit}' <<<"$info")"
  base="$(incus image get-property "$PARA_IMAGE_NAME" user.para.base 2>/dev/null || true)"
  printf '  image    %s\n  built    %s\n  base     %s\n' \
    "$PARA_IMAGE_NAME" "${built:-unknown}" "${base:-unknown}"
}

cmd_image_rm() {
  require_project
  require_incus
  incus image info "$PARA_IMAGE_NAME" >/dev/null 2>&1 || die "no '$PARA_IMAGE_NAME' image to remove."
  incus image delete "$PARA_IMAGE_NAME"
  stage "Removed image '$PARA_IMAGE_NAME'. Rebuild with: para image build"
}

# ---- scaffolding -----------------------------------------------------------
# This script's package root, through any symlink chain. npm global installs,
# npx, and a source checkout all land here. Plain readlink, not readlink -f,
# which macOS doesn't have.
pkg_root() {
  local self="$0" dir link
  while [ -L "$self" ]; do
    dir="$(cd -P "$(dirname "$self")" && pwd)"
    link="$(readlink "$self")"
    case "$link" in /*) self="$link" ;; *) self="$dir/$link" ;; esac
  done
  cd -P "$(dirname "$self")/.." && pwd
}

# `para init` and `para add` are one convergent verb with two names: in a
# fresh directory it scaffolds .paraspace/ (env, stack, the project layer);
# given names it expands them to stack lines and inserts them before the
# project's own layers; and every invocation reruns the configure chain,
# which is idempotent because existing env declarations win. docs/layers.md.
cmd_add() {
  local usage="usage: para add [<name>...] [--list] [--new <name>]"
  local names="" new="" list=0 name
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --list) list=1; shift ;;
      --new)  shift; [ "$#" -gt 0 ] || die "$usage"; new="$1"; shift ;;
      -*|"")  die "$usage" ;;
      *)      names="${names:+$names
}$1"; shift ;;
    esac
  done
  if [ "$list" -eq 1 ]; then add_list; return; fi
  require_project

  local sp="$PARA_PROJECT_DIR/.paraspace" fresh=0
  if [ ! -f "$sp/stack" ]; then
    # Refused before anything is written, or a bare init in a directory with
    # no npm install would scaffold a stack whose base stack_check then
    # reports missing, leaving a half-made project behind.
    if [ -z "$names" ] && [ -z "$new" ] \
      && [ ! -d "$PARA_PROJECT_DIR/node_modules/paraspace/layers/base/void" ]; then
      die "the default base is node_modules/paraspace/layers/base/void, and there is no node_modules/paraspace here. Run 'npm install --save-dev paraspace' first, or name a layer or path: para init <name>."
    fi
    fresh=1
    stage "Scaffolding .paraspace/ in ${PARA_PROJECT_DIR}…"
    layer_stub project
    # The default base only when nothing is named, so an explicit list is
    # exactly what you get. The project's own layer goes last, so its files
    # and verbs win.
    if [ -z "$names" ] && [ -z "$new" ]; then
      printf 'node_modules/paraspace/layers/base/void\n' > "$sp/stack"
    else
      : > "$sp/stack"
    fi
    printf '.paraspace/layers/project\n' >> "$sp/stack"
    info "add: .paraspace/stack"
  fi
  if [ ! -f "$sp/env" ]; then
    printf 'PARA_CONTRACT=%s\n' "$CONTRACT" > "$sp/env"
    info "add: .paraspace/env"
  fi

  local line
  if [ -n "$names" ]; then
    while IFS= read -r name; do
      # Checked, because expand_layer's die runs inside a $( ) where bash
      # strips set -e, so its non-zero status is all that reaches us.
      line="$(expand_layer "$name")" || exit 1
      stack_insert "$line"
    done <<<"$names"
  fi
  if [ -n "$new" ]; then
    layer_stub "$new"
    stack_insert ".paraspace/layers/$new"
  fi

  # The file just changed, so re-derive before checking and configuring.
  PARA_STACK="$(stack_load)"
  stack_check
  run_configures
  if [ "$fresh" -eq 1 ]; then
    stage "Next: review .paraspace/, then 'para image build' and 'para up <name>'."
  fi
}

# 'acme/mod-a' as an installed plugin's layer path, or nothing when the name
# names no vendor.
vendor_candidate() {
  case "$1" in
    */*) printf 'node_modules/paraspace-plugin-%s/layers/%s\n' "${1%%/*}" "${1#*/}" ;;
  esac
}

# A name at add time. Three sugar forms, no more, and the output is always the
# explicit stack line, so the runtime never sees a bare name: a bundled name
# expands under this package's layers/, a vendor name under the plugin's, and
# anything else is a path, tried literally and then under node_modules/. More
# than one match dies naming each, and the fix is writing the full path.
expand_layer() { # expand_layer <name> -> one stack line
  local name="$1" c matches=""
  for c in "node_modules/paraspace/layers/$name" "$(vendor_candidate "$name")" \
           "$name" "node_modules/$name"; do
    [ -n "$c" ] || continue
    case "$c" in
      /*) [ -d "$c" ] || continue ;;
      *)  [ -d "$PARA_PROJECT_DIR/$c" ] || continue ;;
    esac
    matches="${matches:+$matches
}$c"
  done
  if [ -z "$matches" ]; then
    if [ -d "$(pkg_root)/layers/$name" ]; then
      die "'$name' is a bundled layer, but this project has no node_modules/paraspace to load it from. Run 'npm install --save-dev paraspace', or copy it in and add the copy:
  mkdir -p '.paraspace/layers/$(dirname "$name")' && cp -R '$(pkg_root)/layers/$name' '.paraspace/layers/$name' && para add '.paraspace/layers/$name'"
    fi
    die "no layer '$name' (see: para add --list). A directory path works too."
  fi
  case "$matches" in
    *"
"*) die "'$name' matches more than one layer:
$matches
Write the full path of the one you mean." ;;
  esac
  printf '%s\n' "$matches"
}

# Insert <line> into the stack file before the project's own layers, which
# stay last so their files and verbs win. A line already present is a no-op,
# which is what makes add convergent.
stack_insert() { # stack_insert <line>
  local file="$PARA_PROJECT_DIR/.paraspace/stack"
  if stack_lines | grep -qxF "$1"; then
    info "keep: $1 (already in the stack)"
    return 0
  fi
  awk -v line="$1" '
    !done && $0 ~ /^[ \t]*\.paraspace\/layers\// { print line; done = 1 }
    { print }
    END { if (!done) print line }
  ' "$file" > "$file.new"
  mv "$file.new" "$file"
  info "add: $1 (.paraspace/stack)"
}

# Stub .paraspace/layers/<name>: the shape para composes, with nothing in it
# but three hook stubs, since what a hook DOES is the project's to say.
# Convergent, so an existing layer is left alone.
layer_stub() { # layer_stub <name>
  case "/$1/" in
    //*|*/../*|*/./*) die "a layer name is a relative path under .paraspace/layers/; got '$1'." ;;
  esac
  local dest="$PARA_PROJECT_DIR/.paraspace/layers/$1" hook
  if [ -d "$dest" ]; then
    info "keep: .paraspace/layers/$1 (exists)"
    return 0
  fi
  mkdir -p "$dest/hooks"
  for hook in image-build provision boot; do
    hook_stub "$hook" > "$dest/hooks/$hook"
    info "add: .paraspace/layers/$1/hooks/$hook"
  done
}

# What layer_stub writes: para's shape and nothing else. Each stub says when
# it runs, because that is the part a reader cannot see from the file.
hook_stub() { # hook_stub <hook>
  local when=""
  case "$1" in
    image-build) when='as root in the builder. What it installs is baked into the image' ;;
    provision)   when='in the workspace before boot, on every up, so keep it idempotent' ;;
    boot)        when='once the services are up. Return zero only when yours is listening' ;;
  esac
  printf '#!/usr/bin/env bash\nset -euo pipefail\n\n'
  printf '# Runs %s,\n# after every layer above this one in the stack.\n\n' "$when"
  # shellcheck disable=SC2016  # the generated hook expands this, para does not
  printf '# shellcheck source=/dev/null\n. "$PARA_HELPERS"\n'
}

# Each layer's configure, host-side, in stack order. A layer proposes env
# values through maybe_write_env; existing declarations win, explicit
# empty ones included, so the chain is idempotent and add reruns it wholesale
# on every invocation. A failure leaves the writes made so far in place, and
# rerunning after the fix converges.
run_configures() {
  local dir name status
  # The list rides fd 3 so a configure keeps the caller's stdin and can prompt.
  while IFS= read -r dir <&3; do
    [ -n "$dir" ] || continue
    [ -f "$dir/configure" ] || continue
    name="$(layer_name "$dir")"
    stage "Configuring '$name' on YOUR machine with your privileges…"
    status=0
    (
      cd "$PARA_PROJECT_DIR"
      # shellcheck disable=SC2030,SC2034  # read by the export below, via ${!PARA_@}
      PARA_LAYER_DIR="$dir"
      export "${!PARA_@}"
      bash "$dir/configure"
    ) || status=$?
    # The layer's own status, handed back unchanged rather than flattened to 1.
    if [ "$status" -ne 0 ]; then
      warn "the '$name' configure failed (exit $status). Fix the cause above, then re-run: para add"
      exit "$status"
    fi
  done 3< <(stack_dirs)
}

# The one flat catalog: bundled layers, installed plugins' layers, and the
# project's own, named exactly as add accepts them, the ones already in the
# stack checked. It answers both "what can I add" and "what do I have".
add_list() {
  local have pdir vendor display line
  have="$(stack_lines)"
  {
    catalog_names "$(pkg_root)/layers" "" "node_modules/paraspace/layers/"
    for pdir in "$PARA_PROJECT_DIR"/node_modules/paraspace-plugin-*/layers; do
      if [ -d "$pdir" ]; then
        vendor="${pdir%/layers}"; vendor="${vendor##*paraspace-plugin-}"
        catalog_names "$pdir" "$vendor/" "node_modules/paraspace-plugin-$vendor/layers/"
      fi
    done
    catalog_names "$PARA_PROJECT_DIR/.paraspace/layers" ".paraspace/layers/" ".paraspace/layers/"
  } | sort | while IFS="$(printf '\t')" read -r display line; do
    if printf '%s\n' "$have" | grep -qxF "$line"; then
      printf '✔ %s\n' "$display"
    else
      printf '  %s\n' "$display"
    fi
  done
}

# The layers under one root, as "display<TAB>stack line" rows: the directories
# at the top, plus base/* one level down, which is the whole recognized shape.
catalog_names() { # catalog_names <root-dir> <display-prefix> <line-prefix>
  local d rel
  for d in "$1"/*/ "$1"/base/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"
    rel="${d#"$1"/}"
    [ "$rel" = base ] || printf '%s%s\t%s%s\n' "$2" "$rel" "$3" "$rel"
  done
}

# ---- layer commands ---------------------------------------------------------
# A layer extends para by dropping an executable in its commands/: `para
# <verb>` runs it on the HOST, with every PARA_* exported and its arguments
# passed through. Engine verbs always win, and between layers the later
# layer's verb wins, the same rule as skel files. docs/commands.md.
project_commands() {
  local dir f
  while IFS= read -r dir; do
    for f in "$dir"/commands/*; do
      if [ -f "$f" ]; then printf '%s\n' "${f##*/}"; fi
    done
  done < <(stack_dirs) | sort -u
}

# Every command file answering to <verb>, in stack order.
command_files() { # command_files <verb>
  local dir
  while IFS= read -r dir; do
    if [ -f "$dir/commands/$1" ]; then printf '%s\n' "$dir/commands/$1"; fi
  done < <(stack_dirs)
}

# The file `para <verb>` runs, or nothing: the LAST layer that defines it,
# so the project layer, sitting last, can replace any verb above it.
command_path() { # command_path <verb>
  local f found=""
  while IFS= read -r f; do found="$f"; done < <(command_files "$1")
  [ -n "$found" ] || return 1
  printf '%s\n' "$found"
}

# The "# summary: …" line a command may carry, for `para --help`.
command_summary() { sed -n '1,5s/^# summary: *//p' "$1"; }

run_project_command() {
  local verb="$1" script
  shift
  # A verb names a file in a layer's commands/, never a path out of one.
  case "$verb" in */*|.|..) die "unknown command '$verb'. See 'para --help'." ;; esac
  script="$(command_path "$verb")" || die "unknown command '$verb'. See 'para --help'."
  require_project   # commands are part of the contract, so honour the pin
  # PARA_LAYER_DIR is how a command finds its own files, and it is always the
  # owning layer's: a stale value inherited from a calling command must not
  # leak through, so it is reasserted rather than trusted.
  # shellcheck disable=SC2034  # read by the export below, via ${!PARA_@}
  PARA_LAYER_DIR="${script%/commands/*}"
  # Layers run in place, so nothing repairs a bit a zip, a tarball, or a
  # core.fileMode=false checkout lost. Name the fix instead of exec's
  # "permission denied".
  [ -x "$script" ] || die "'$verb' is not executable. Fix: chmod +x '$script'"
  export "${!PARA_@}"
  exec "$script" "$@"
}

# ---- diagnosis -------------------------------------------------------------
# Everything para knows about how a host can be wrong lives here, so that the
# commands you use every day don't carry it. Run it when something is off.
DOCTOR_FAILED=0
d_ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
d_warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
d_bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; DOCTOR_FAILED=1; }

cmd_doctor() {
  # Every check below reads something that may be absent or broken, which IS the
  # job, so this one command does not inherit `set -e`. Without it a diagnostic
  # stops at the first thing it cannot read, which is the moment you most need
  # the rest of the report.
  set +e
  printf '\nconfig\n'
  doctor_config
  printf '\nhost\n'
  doctor_host
  printf '\nincus\n'
  doctor_incus
  printf '\nproject\n'
  doctor_project
  printf '\n'
  [ "$DOCTOR_FAILED" -eq 0 ] || die "some checks failed. See above."
}

doctor_config() {
  printf '    user config        %s\n' "$PARA_CONFIG"
  printf '    state              %s\n' "$PARA_STATE_DIR"
  printf '    project dir        %s\n' "${PARA_PROJECT_DIR:-<none>}"
  printf '    PARA_PROJECT_NAME  %s\n' "${PARA_PROJECT_NAME:-<none>}"
  printf '    PARA_IMAGE_NAME    %s\n' "${PARA_IMAGE_NAME:-<none>}"
  printf '    PARA_DOMAIN        %s\n' "$PARA_DOMAIN"
  printf '    PARA_ROUTES        %s\n' "${PARA_ROUTES:-<none>}"
  printf '    PARA_POOL          %s\n' "$PARA_POOL"
  printf '    PARA_VOLUME        %s\n' "${PARA_PROJECT_NAME:+$PARA_VOLUME}"
  printf '    Caddy port         %s\n' "$PARA_HTTPS_PORT"
  # Caddy site addresses are whitespace-separated, so a domain with a space in
  # it becomes TWO addresses and `caddy validate` accepts the result happily,
  # the one bad value the generated Caddyfile cannot catch for itself.
  case "$PARA_DOMAIN" in
    *[[:space:]]*) d_bad "PARA_DOMAIN contains whitespace, so Caddy reads '<workspace>.$PARA_DOMAIN' as two site addresses and none of your URLs will resolve" ;;
  esac
  # The user config describes your box, so a project-shaped key there applies
  # to every project on it. Nothing refuses that; this says it out loud.
  local key
  for key in PARA_PROJECT_NAME PARA_IMAGE_NAME PARA_ORIGIN PARA_ROUTES PARA_IMAGE_BASE PARA_VOLUME; do
    if [ -f "$PARA_CONFIG" ] && grep -q "^[^#]*$key" "$PARA_CONFIG"; then
      d_warn "$key is set in the user config, so it applies to EVERY project on this box. It probably belongs in the project's .paraspace/env."
    fi
  done
}

doctor_host() {
  if command -v caddy >/dev/null 2>&1; then d_ok "caddy present"; else d_bad "caddy not on PATH"; fi
  if caddy_running; then d_ok "para Caddy running on :$PARA_HTTPS_PORT"
  else d_warn "para Caddy not running ('para caddy start', or any 'para up')"; fi
  # Binding a port below 1024 as a normal user needs the capability on the binary.
  if [ "$PARA_HTTPS_PORT" -lt 1024 ] && command -v getcap >/dev/null 2>&1; then
    local bin
    bin="$(readlink -f "$(command -v caddy)")"
    if getcap "$bin" 2>/dev/null | grep -q cap_net_bind_service; then
      d_ok "caddy may bind :$PARA_HTTPS_PORT"
    else
      d_bad "caddy cannot bind :$PARA_HTTPS_PORT unprivileged. Run sudo setcap cap_net_bind_service=+ep $bin (re-apply after a caddy upgrade), or use the default :8443"
    fi
  fi
  # The wildcard must resolve to this machine or no workspace URL will load.
  if ! command -v getent >/dev/null 2>&1; then
    d_warn "no getent here. Check by hand that *.$PARA_DOMAIN resolves to 127.0.0.1"
  elif getent hosts "doctor.$PARA_DOMAIN" | grep -q '^127\.'; then
    d_ok "*.$PARA_DOMAIN resolves to 127.0.0.1"
  else
    d_bad "*.$PARA_DOMAIN does not resolve to 127.0.0.1, so workspace URLs will not load (docs/urls.md)"
  fi
  # A named cgroup-v1 hierarchy under /sys/fs/cgroup makes LXC fail every
  # container start with a cryptic "Failed to create cgroup at_mnt".
  local v1
  v1="$(awk '$3 == "cgroup" && $2 ~ /^\/sys\/fs\/cgroup\//{print $2}' /proc/mounts 2>/dev/null | tr '\n' ' ')"
  [ -z "$v1" ] || d_bad "cgroup-v1 mounted inside /sys/fs/cgroup (${v1% }). No container will start until you unmount it: sudo umount -l ${v1% }"
}

doctor_incus() {
  if ! command -v incus >/dev/null 2>&1; then d_bad "incus not on PATH"; return; fi
  if ! incus info >/dev/null 2>&1; then d_bad "incus daemon unreachable. Try 'incus admin init', or start colima on macOS"; return; fi
  # The probe decides, not the version: a distro may backport, and an incus that
  # cannot do this rejects the column rather than returning it empty, which
  # would be far worse, since para would read every workspace as address-less.
  local v
  v="$(incus version | awk '/Client version/{print $3}')"
  if ! incus list -f csv -c 'devices:eth0.ipv4.address' >/dev/null 2>&1; then
    d_bad "incus ${v:-?} cannot select device columns, which is how para reads workspace state. Upgrade to $MIN_INCUS or newer (Ubuntu's repos ship 6.2)"
  elif [ -n "$v" ] && ! version_ge "$v" "$MIN_INCUS"; then
    d_warn "incus $v is older than the $MIN_INCUS para is tested against. It can do what para needs, but expect surprises"
  else
    d_ok "incus $v"
  fi
  local driver
  driver="$(incus storage list -f csv 2>/dev/null | awk -F, -v p="$PARA_POOL" '$1 == p {print $2}')"
  if [ -z "$driver" ]; then
    d_bad "storage pool '$PARA_POOL' does not exist. Create one with: incus storage create $PARA_POOL dir"
  else
    d_ok "pool '$PARA_POOL' ($driver)"
    doctor_storage "$driver"
  fi
  if incus network get "$PARA_BRIDGE" ipv4.address >/dev/null 2>&1; then
    d_ok "bridge '$PARA_BRIDGE' up"
  else
    d_bad "bridge '$PARA_BRIDGE' has no ipv4.address"
  fi
}

# Nested Docker on btrfs, or on ZFS before 2.2, silently falls back to the vfs
# storage driver, the slowest failure para has. And the shared volume needs
# idmapped mounts, without which a workspace dies mid-boot with "Required
# idmapping abilities not available".
doctor_storage() {
  local driver="$1" zv
  case "$(uname -s)/$driver" in
    Linux/btrfs|Linux/zfs)
      d_warn "pool '$PARA_POOL' is $driver-backed, so nested Docker falls back to vfs. Put para on a dir pool over ext4/xfs: incus storage create para-dir dir source=/path/on/ext4" ;;
  esac
  if ! grep -qw shiftfs /proc/filesystems 2>/dev/null; then
    if [ "$(incus info | awk -F'"' '/^[[:space:]]*idmapped_mounts:/{print $2; exit}')" = false ]; then
      d_bad "this kernel cannot do idmapped mounts, which the shared volume needs. Upgrade to >= 5.12 (>= 5.15 for btrfs)"
    fi
    zv="$(zfs_version)"
    if [ -n "$zv" ] && ! version_ge "$zv" 2.2; then
      d_warn "OpenZFS $zv is older than 2.2, so if the pool lives on ZFS the shared volume will fail to attach at boot"
    fi
  fi
}

zfs_version() { sed 's/-.*//' /sys/module/zfs/version 2>/dev/null || true; }
version_ge() { [ "$1" = "$2" ] || [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }

doctor_project() {
  if [ -z "$PARA_PROJECT_DIR" ]; then d_warn "not inside a para project"; return; fi
  if [ -z "$PARA_CONTRACT" ]; then
    d_warn "the env file declares no PARA_CONTRACT. Add PARA_CONTRACT=$CONTRACT so a breaking para change fails loudly"
  elif [ "$PARA_CONTRACT" = "$CONTRACT" ]; then
    d_ok "env targets contract $PARA_CONTRACT"
  else
    d_bad "this project targets contract $PARA_CONTRACT, but this para provides $CONTRACT. See docs/versioning.md"
  fi
  doctor_stack
  if [ -n "$PARA_ROUTES" ]; then d_ok "routes: $PARA_ROUTES"; else d_warn "no PARA_ROUTES, so this project publishes no HTTP"; fi
  # Derived from the checkout, so it is worth showing which repo that came out as.
  if [ -n "$PARA_ORIGIN" ]; then d_ok "origin: $PARA_ORIGIN"; else d_warn "no PARA_ORIGIN, and no git origin here to derive one from, so a hook that clones has nothing to clone"; fi
  if incus image info "$PARA_IMAGE_NAME" >/dev/null 2>&1; then d_ok "image '$PARA_IMAGE_NAME' exists"
  else d_bad "no image '$PARA_IMAGE_NAME'. Build it with: para image build"; fi
  # A command that shadows an engine verb never runs; the engine verb wins.
  local verb
  while IFS= read -r verb; do
    if is_engine_verb "$verb"; then doctor_shadowed "$verb"; fi
  done < <(project_commands)
}

# The resolved chain, in order, each line checked on disk. Every layer
# composes identically, but a chain with no base (no 'base/' path component)
# or with several usually means a broken image contract, so say so.
doctor_stack() {
  if [ -z "$PARA_STACK" ]; then
    d_warn "no .paraspace/stack, so the stack is empty and no hooks will run. Start with: para add"
    return
  fi
  local dir rel bases=0 dupes
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    rel="${dir#"$PARA_PROJECT_DIR"/}"
    if [ -d "$dir" ]; then d_ok "layer $rel"; else d_bad "layer $rel is missing ('npm install', or fix .paraspace/stack)"; fi
    case "/$rel/" in */base/*) bases=$((bases + 1)) ;; esac
  done < <(stack_dirs)
  dupes="$(stack_dupe_lines)"
  [ -z "$dupes" ] || d_bad "duplicate stack lines: $(printf '%s' "$dupes" | tr '\n' ' ')"
  dupes="$(stack_dupe_names)"
  [ -z "$dupes" ] || d_bad "two stack lines share a layer name: $(printf '%s' "$dupes" | tr '\n' ' ')"
  if [ "$bases" -eq 0 ]; then
    d_warn "the stack has no base layer, so nothing establishes the image, its bootstrap, or its user"
  elif [ "$bases" -gt 1 ]; then
    d_warn "the stack has $bases base layers; usually exactly one establishes the image"
  fi
}

# Everything that defines a verb the engine already owns. All of them, not
# the one that would have run: none of them will.
doctor_shadowed() { # doctor_shadowed <verb>
  local path
  while IFS= read -r path; do
    d_warn "layer $(layer_name "${path%/commands/*}")'s command '$1' is shadowed by the engine verb of the same name"
  done < <(command_files "$1")
}

# ---- help ------------------------------------------------------------------
is_engine_verb() {
  case "$1" in
    up|down|rm|ls|sh|caddy|config|image|init|add|doctor|commands|completions|exec) return 0 ;;
    # Every spelling main dispatches, or doctor stays silent about a command
    # named for one and the reader never learns why theirs does nothing.
    help|-h|--help|--version) return 0 ;;
    *) return 1 ;;
  esac
}

usage() {
  cat <<-EOF
	para - parallel dev workspaces on Incus

	WORKSPACES
	  up <name>                 create or reconverge a workspace, then boot it
	  down <name>               stop it (data kept)
	  rm <name>                 delete it
	  ls [-a|--all] [--names]   list workspaces, this project's by default
	  sh <name> [-c <command>]  a shell in the clone, or one command in it

	HOST
	  caddy <start|stop|status> the para Caddy that serves *.$PARA_DOMAIN
	  doctor                    check this machine, and print the resolved config
	  config <edit|init|path>   the user config: open it in \$EDITOR (seeding it
	                            on first use), or seed it, or say where it is

	PROJECT
	  init | add [<name>...]    scaffold .paraspace/ if needed and add layers to
	                            the stack (--list, --new <name>)
	  image <build|status|rm>   the base image workspaces launch from
	  commands                  the verbs this project's layers add
	  completions <bash|zsh>    source <(para completions bash)
	  --version                 the installed paraspace version
	EOF
  usage_project_commands
  cat <<-EOF

	Docs: README.md and docs/. Contract version: $CONTRACT.
	EOF
}

# A project's own verbs, listed so nothing a layer added runs invisibly,
# which is why each row names the layer it resolved to.
usage_project_commands() {
  local list verb path
  list="$(project_commands)"
  [ -n "$list" ] || return 0
  printf '\nPROJECT COMMANDS (%s/.paraspace)\n' "$PARA_PROJECT_DIR"
  while IFS= read -r verb; do
    path="$(command_path "$verb")" || continue
    # A verb named for an engine verb never runs; the engine wins, and doctor
    # is where that gets pointed out.
    if is_engine_verb "$verb"; then
      printf '  %-25s %s\n' "$verb" "never runs, since the engine verb wins (para doctor)"
    else
      printf '  %-25s %s [%s]\n' "$verb" "$(command_summary "$path")" "$(layer_name "${path%/commands/*}")"
    fi
  done <<<"$list"
}

cmd_completions() {
  case "${1:-}" in
    bash) ;;
    zsh) cat <<-'EOF'
	if ! whence compdef >/dev/null 2>&1; then autoload -U +X compinit && compinit; fi
	autoload -U +X bashcompinit && bashcompinit
	EOF
      ;;
    *) die "usage: para completions <bash|zsh>. Then: source <(para completions bash)" ;;
  esac
  cat <<-'EOF'
	_para() {
	  local cur="${COMP_WORDS[COMP_CWORD]}" cmd="${COMP_WORDS[1]:-}"
	  local verbs="up down rm ls sh caddy config image init add doctor commands completions help"

	  if [ "$COMP_CWORD" -eq 1 ]; then
	    COMPREPLY=( $(compgen -W "$verbs $(para commands 2>/dev/null)" -- "$cur") )
	    return
	  fi
	  case "$cmd" in
	    caddy)       COMPREPLY=( $(compgen -W "start stop status" -- "$cur") ) ;;
	    config)      COMPREPLY=( $(compgen -W "edit init path" -- "$cur") ) ;;
	    image)       COMPREPLY=( $(compgen -W "build status rm" -- "$cur") ) ;;
	    completions) COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") ) ;;
	    # The catalog rows are "checkmark name"; the name is the last field.
	    init|add)    COMPREPLY=( $(compgen -W "--list --new $(para add --list 2>/dev/null | awk '{print $NF}')" -- "$cur") ) ;;
	    ls)          COMPREPLY=( $(compgen -W "--all --names" -- "$cur") ) ;;
	    # Everything else, including every project command, takes a workspace.
	    *)           [ "$COMP_CWORD" -eq 2 ] \
	                   && COMPREPLY=( $(compgen -W "$(para ls --names 2>/dev/null)" -- "$cur") ) ;;
	  esac
	}
	complete -F _para para
	EOF
}

cmd_version() {
  sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$(pkg_root)/package.json" | head -1
}

# ---- dispatch --------------------------------------------------------------
main() {
  # Sourced before load_config, so die and stage work while it reads, and it is
  # the one place this path is written; load_config exports it as PARA_HELPERS.
  HELPERS="$(pkg_root)/libexec/helpers"
  # shellcheck source=/dev/null
  . "$HELPERS"
  local cmd="${1:-}"
  shift || true
  # init/add may be creating the project here, so the root they operate on is
  # pinned before load_config derives identity from it: the enclosing
  # project, or the current directory.
  case "$cmd" in
    init|add) PARA_PROJECT_DIR="${PARA_PROJECT_DIR:-$(find_project_root || pwd)}" ;;
  esac
  load_config
  case "$cmd" in
    up)          cmd_up "$@" ;;
    down)        cmd_down "$@" ;;
    rm)          cmd_rm "$@" ;;
    ls)          cmd_ls "$@" ;;
    sh)          cmd_sh "$@" ;;
    caddy)       cmd_caddy "$@" ;;
    config)      cmd_config "$@" ;;
    image)       cmd_image "$@" ;;
    init|add)    cmd_add "$@" ;;
    doctor)      cmd_doctor "$@" ;;
    commands)    project_commands ;;
    completions) cmd_completions "$@" ;;
    ""|-h|--help|help) usage ;;
    --version)   cmd_version ;;
    # para wraps `incus exec`, so container muscle memory reaches for this.
    exec)        die "no 'exec' command. Run one command in a workspace with: para sh <name> -c '<command>'" ;;
    *)           run_project_command "$cmd" "$@" ;;
  esac
}

main "$@"
