#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
. "$PARA_HELPERS"

has_compose() { # has_compose <dir>
  [ -f "$1/compose.yaml" ] || [ -f "$1/compose.yml" ] \
    || [ -f "$1/docker-compose.yaml" ] || [ -f "$1/docker-compose.yml" ]
}

if has_compose "$HOME/$PARA_CLONE_DIR"; then
  command -v docker >/dev/null 2>&1 \
    || die "docker is not in the workspace image. Run: para image build"
  cd "$HOME/$PARA_CLONE_DIR"
  stage "docker compose up"
  docker compose up -d --wait --wait-timeout 300
fi
