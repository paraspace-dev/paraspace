#!/usr/bin/env bash
set -euo pipefail
# dotfiles image-build hook. Runs as root in the builder after the base's
# image-build, so $PARA_USER exists and xbps is already synced.
#
# Bakes in what the dotfiles need (a Neovim toolchain, the shell tools the zshrc
# reaches for, Claude Code) but NOT the Neovim plugins, which live on the shared
# volume and install once, at first launch, for every workspace of the project.
#
# Like every unprefixed bundled layer, this targets the Void base and uses xbps.

# shellcheck source=/dev/null
. "$PARA_HELPERS"

# Where the base actually put the home, not where useradd -m would have: the
# image contract promises the user exists, never which directory it got.
home="$(getent passwd "${PARA_USER:?}" | cut -d: -f6)" || home=""
[ -n "$home" ] \
  || die "no home for '$PARA_USER'. This layer runs after a base image-build that creates the user. See docs/image.md."

stage "Toolchain the dotfiles assume"
# Everything skel/ reaches for, plus what builds it: nvim-treesitter shells out
# to tree-sitter-cli and base-devel compiles its parsers. The base owns zsh;
# tmux remains part of this personal toolchain.
pkgs="tmux just neovim nodejs tree-sitter-cli base-devel ripgrep fd bat fzf lsd tree xz curl"
# shellcheck disable=SC2086  # package names are the fixed words above
xbps_install $pkgs >/dev/null

stage "Claude Code (as $PARA_USER)"
# The native installer puts the binary in ~/.local/share/claude and a launcher in
# ~/.local/bin. It seeds ~/.claude too, and provision links that at the shared
# volume, so don't bake a real directory in for the link to land in.
if [ ! -x "$home/.local/bin/claude" ]; then
  su - "$PARA_USER" -c 'curl --connect-timeout 20 --max-time 300 --retry 5 --retry-delay 2 --retry-connrefused -fsSL https://claude.ai/install.sh | bash' >/dev/null
  rm -rf "$home/.claude" "$home/.claude.json"
else
  info "already installed, skipping"
fi
# On the system PATH, because a non-interactive `su - -c` login shell never reads
# the zshrc that adds ~/.local/bin. The launcher self-updates in place, so link
# the launcher and not a pinned version directory.
ln -sf "$home/.local/bin/claude" /usr/local/bin/claude

stage "Claude Code managed policy"
# The highest-precedence settings layer, root-owned and container-local, so a
# theme or UI change written into the shared config can't clobber defaultMode.
mkdir -p /etc/claude-code
printf '%s\n' '{ "permissions": { "defaultMode": "acceptEdits" }, "includeCoAuthoredBy": false }' \
  > /etc/claude-code/managed-settings.json

stage "git aliases"
# System scope, so the shared volume's gitconfig keeps the per-user identity and
# neither can clobber the other, since git merges system -> global -> local.
cat > /etc/gitconfig <<'EOF'
[alias]
	unstage = reset HEAD --
	graph = log --graph --abbrev-commit --decorate --oneline
	graphgpg = log --graph --abbrev-commit --decorate --oneline --show-signature
EOF

stage "\$BROWSER for a box with no browser"
# Tools that "open" a URL (`gh auth login`'s device flow, `gh ... --web`) die
# with "xdg-open not found" otherwise. /etc/profile.d reaches every login shell,
# which is what para runs hooks in, so the base's own gh flow gets it too.
printf 'export BROWSER=%s\n' "$PARA_SHARED/bin/open-url" > /etc/profile.d/dotfiles.sh
