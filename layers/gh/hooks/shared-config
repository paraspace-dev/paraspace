# Sourced, never run: only an exact hook-name match runs out of hooks/. It
# leaves this layer's directory on the shared volume in $shared.
#
# Both this layer's provision and its git:before source it, so whichever runs
# first puts ~/.config/gh on the shared volume, and a `gh auth login` during
# git:before can never be written into a directory the other later replaces.

shared="$PARA_SHARED/gh"
mkdir -p "$shared" ~/.config
if [ ! -L ~/.config/gh ]; then rm -rf ~/.config/gh; fi
ln -sfn "$shared" ~/.config/gh
