# Source this file to set $shared to this layer's directory on the shared volume.
# The hook runner executes only exact hook-name matches.
#
# provision and git:before both source this file to link ~/.config/gh before
# login. This keeps later provisioning from replacing the login directory.

shared="$PARA_SHARED/gh"
mkdir -p "$shared" ~/.config
if [ ! -L ~/.config/gh ]; then rm -rf ~/.config/gh; fi
ln -sfn "$shared" ~/.config/gh
