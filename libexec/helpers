#!/usr/bin/env bash
# Shared helpers for para hooks and project commands. Sourced, not executed:
#   . "$PARA_HELPERS"

# Color, but only on a terminal, because para captures hook output to logs.
if [ -t 2 ]; then
  _hd=$'\033[36;1m'; _wn=$'\033[33m'; _er=$'\033[31m'; _off=$'\033[0m'
else
  _hd='' _wn='' _er='' _off=''
fi

stage() { printf '%s==> %s%s\n'   "$_hd" "$*" "$_off" >&2; }  # section header
info()  { printf '    %s\n'        "$*"               >&2; }  # indented detail
warn()  { printf '%swarn:%s %s\n'  "$_wn" "$_off" "$*" >&2; }
die()   { printf '%serror:%s %s\n' "$_er" "$_off" "$*" >&2; exit 1; }

# Is there a human to prompt? (Set PARA_NONINTERACTIVE=1 in CI/cron; para
# reads it too, and gives a hook no tty when it is set.)
interactive() { [ -z "${PARA_NONINTERACTIVE:-}" ] && [ -t 0 ] && [ -t 1 ]; }

# Print a prompt and wait for Enter, only when someone can answer.
pause() { if interactive; then printf '%s ' "$*" >&2; read -r _ || true; fi; }

# Add one project setting without taking ownership away from the project. Both
# assignment spellings documented for Parafiles count, including an explicitly
# empty value. This is a host helper; guest hooks do not have a Parafile.
set_parafile_var_if_not_set() { # set_parafile_var_if_not_set <PARA_NAME> <value>
  [ "$#" -eq 2 ] || die "usage: set_parafile_var_if_not_set <PARA_NAME> <value>"
  local name="$1" value="$2" parafile="${PARA_PROJECT_DIR:-}/.paraspace/Parafile"
  [[ "$name" =~ ^PARA_[A-Z0-9_]+$ ]] \
    || die "invalid Parafile variable '$name': expected a PARA_* name using uppercase letters, digits and underscores"
  [ -f "$parafile" ] || die "no Parafile at $parafile"

  # Direct assignments and the documented defaulting idioms are authoritative.
  # Anchor the complete variable name so PARA_ROUTE never matches PARA_ROUTES.
  if grep -Eq "^[[:space:]]*(export[[:space:]]+)?${name}[[:space:]]*=" "$parafile" \
    || grep -Eq "^[[:space:]]*:[[:space:]]+['\"]?[$][{]${name}:=" "$parafile"; then
    return 0
  fi

  printf '\n%s=%q\n' "$name" "$value" >> "$parafile"
  info "Set $name in .paraspace/Parafile."
}

# Install only packages the Void image does not already contain, in one xbps
# transaction. This is a guest/image-build helper and expects xbps-query and
# xbps-install to be available there.
xbps_install() { # xbps_install <package>...
  local package missing=""
  for package in "$@"; do
    xbps-query "$package" >/dev/null 2>&1 || missing="${missing:+$missing }$package"
  done
  # shellcheck disable=SC2086  # the words assembled above; a package name has none
  if [ -n "$missing" ]; then xbps-install -Sy $missing; fi
}

# No route helpers here on purpose: para injects $PARA_ROUTES space-separated,
# so a hook that wants them writes `for r in $PARA_ROUTES` and one that wants
# ports writes `${r##*:}`.
