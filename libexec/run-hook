#!/usr/bin/env bash
# Run <hook> from every .paraspace dir here: the project's, then each mod's.
# See docs/hooks.md.
name="${1:?usage: run-hook <name>}"
root="$(cd "$(dirname "$0")" && pwd)"
stack="${PARA_HOOK_STACK:-}"
export PARA_RUN_HOOK="$root/run-hook"
export PARA_HELPERS="${PARA_HELPERS:-$root/helpers}"
# shellcheck source=/dev/null
. "$PARA_HELPERS"
ran=0

case " $stack " in
  *" $name "*) die "hook cycle: $stack > $name" ;;
esac
export PARA_HOOK_STACK="${stack:+$stack > }$name"

for pdir in "$root" "$root"/mods/*; do
  hook="$pdir/hooks/$name"
  [ -f "$hook" ] || continue
  stage "hook: ${hook#"$root"/}"
  PARA_HOOKS="$pdir/hooks" PARA_SKEL="$pdir/skel" bash "$hook"
  status=$?  # its own line, NOT `if ! …; then`, which reports the status of `!`.
  if [ "$status" -ne 0 ]; then
    # shellcheck disable=SC2154  # helpers initializes its private color codes
    printf '%serror:%s hook failed (exit %s): %s\n' \
      "$_er" "$_off" "$status" "${hook#"$root"/}" >&2
    if [ -n "$stack" ]; then printf '  stack: %s\n' "$PARA_HOOK_STACK" >&2; fi
    exit "$status"
  fi
  ran=1
done
if [ "$ran" -eq 0 ]; then
  stage "no '$name' hook"
fi
