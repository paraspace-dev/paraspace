#!/usr/bin/env bash
# Run <hook> from every layer in $PARA_STACK, in stack order. See docs/hooks.md.
name="${1:?usage: run-hook <name>}"
root="$(cd "$(dirname "$0")" && pwd)"
chain="${PARA_HOOK_CHAIN:-}"
export PARA_RUN_HOOK="$root/run-hook"
export PARA_HELPERS="${PARA_HELPERS:-$root/helpers}"
# shellcheck source=/dev/null
. "$PARA_HELPERS"
ran=0

case " $chain " in
  *" $name "*) die "hook cycle: $chain > $name" ;;
esac
export PARA_HOOK_CHAIN="${chain:+$chain > }$name"

# The list rides fd 3 so the hooks keep the caller's stdin (provision prompts).
while IFS= read -r layer <&3; do
  [ -n "$layer" ] || continue
  hook="$layer/hooks/$name"
  [ -f "$hook" ] || continue
  stage "hook: ${hook#"$root"/stack/}"
  PARA_LAYER_DIR="$layer" bash "$hook"
  status=$?  # its own line, NOT `if ! …; then`, which reports the status of `!`.
  if [ "$status" -ne 0 ]; then
    # shellcheck disable=SC2154  # helpers initializes its private color codes
    printf '%serror:%s hook failed (exit %s): %s\n' \
      "$_er" "$_off" "$status" "${hook#"$root"/stack/}" >&2
    if [ -n "$chain" ]; then printf '  chain: %s\n' "$PARA_HOOK_CHAIN" >&2; fi
    exit "$status"
  fi
  ran=1
done 3<<<"${PARA_STACK:-}"
if [ "$ran" -eq 0 ]; then
  stage "no '$name' hook"
fi
