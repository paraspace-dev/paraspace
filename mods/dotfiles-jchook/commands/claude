#!/usr/bin/env bash
# summary: run Claude Code in the workspace clone
set -euo pipefail
# `para sh` owns the terminal handling — a pty only when both ends are
# terminals, su --pty so SIGWINCH reaches the child, and a TERM the container
# has terminfo for — so a command like this stays a one-liner.
[ "$#" -ge 1 ] || { echo "usage: para claude <workspace> [claude args…]" >&2; exit 1; }
ws="$1"; shift

# The command crosses into the container as ONE string a shell there re-parses,
# so the arguments are the only thing that has to survive a second parse — a
# bare "$*" would turn `-p 'write a test'` into four of them.
args=""
if [ "$#" -gt 0 ]; then args="$(printf '%q ' "$@")"; fi

# The name crosses out of band, as the $PARA_NAME para exports into every
# workspace. --name labels the session, which Claude Code puts in the terminal
# title, so a full-screen claude stays identifiable as this workspace.
# shellcheck disable=SC2016  # the guest expands this, not us
guest='exec claude --name "$PARA_NAME" '

exec "$PARA_BIN" sh "$ws" -c "$guest$args"
