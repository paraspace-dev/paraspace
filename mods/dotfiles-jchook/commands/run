#!/usr/bin/env bash
# summary: attach a tmux session — claude in one window, a shell in another
set -euo pipefail
[ "$#" -eq 1 ] || { echo "usage: para run <workspace>" >&2; exit 1; }

# The workspace name crosses out of band, as the $PARA_NAME para exports into
# every workspace. It names the tmux session too, so it shows in tmux's status
# line and the outer terminal title even when claude is full-screen.
# shellcheck disable=SC2016  # the guest expands these, not us
guest='
  # Re-running attaches the existing session rather than stacking duplicates.
  if tmux has-session -t "$PARA_NAME" 2>/dev/null; then exec tmux attach -t "$PARA_NAME"; fi
  tmux new-session -d -s "$PARA_NAME" -n claude claude --name "$PARA_NAME"
  tmux new-window -t "$PARA_NAME": -n sh
  tmux select-window -t "$PARA_NAME":1
  exec tmux attach -t "$PARA_NAME"
'

exec "$PARA_BIN" sh "$1" -c "$guest"
