#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
. "$PARA_HELPERS"

command -v git >/dev/null 2>&1 \
  || die "git is not in the workspace image. Run: para image build"
[ -n "${PARA_ORIGIN:-}" ] \
  || die "no PARA_ORIGIN or checkout origin. Set it in .paraspace/Parafile."

root="$PARA_SHARED/git"
mkdir -p "$root/ssh" ~/.config/para ~/.ssh
chmod 700 "$root/ssh" ~/.ssh

if [ ! -f "$root/gitconfig" ]; then
  stage "Seeding the shared gitconfig"
  printf '[user]\n\tname = %s\n\temail = %s\n[init]\n\tdefaultBranch = main\n' \
    "${PARA_GIT_NAME:-}" "${PARA_GIT_EMAIL:-}" > "$root/gitconfig"
fi
if [ ! -f "$root/ssh/id_ed25519" ]; then
  stage "Creating the shared Git SSH key"
  ssh-keygen -t ed25519 -N "" -C "para-${PARA_HOSTNAME:-$(hostname)}" \
    -f "$root/ssh/id_ed25519" >/dev/null
fi
ln -sfn "$root/gitconfig" ~/.gitconfig
ln -sfn "$root/ssh/id_ed25519" ~/.ssh/id_ed25519
ln -sfn "$root/ssh/id_ed25519.pub" ~/.ssh/id_ed25519.pub
printf '%s\n' "$PARA_CLONE_DIR" > ~/.config/para/clone-dir

ssh_origin() {
  case "$PARA_ORIGIN" in
    ssh://*|*@*:*) return 0 ;;
    *) return 1 ;;
  esac
}

ssh_host() {
  local host
  case "$PARA_ORIGIN" in
    ssh://*) host="${PARA_ORIGIN#ssh://}"; host="${host#*@}"; host="${host%%[/:]*}" ;;
    *@*:*)   host="${PARA_ORIGIN%%:*}"; host="${host#*@}" ;;
    *)       return 1 ;;
  esac
  printf '%s\n' "$host"
}

if ssh_origin; then
  host="$(ssh_host)"
  if ! ssh-keygen -F "$host" >/dev/null 2>&1; then
    ssh-keyscan -H "$host" >> ~/.ssh/known_hosts 2>/dev/null || true
  fi
fi

clone() {
  if [ -n "${PARA_CLONE_BRANCH:-}" ]; then
    git clone --branch "$PARA_CLONE_BRANCH" "$PARA_ORIGIN" "$HOME/$PARA_CLONE_DIR"
  else
    git clone "$PARA_ORIGIN" "$HOME/$PARA_CLONE_DIR"
  fi
}

dest="$HOME/$PARA_CLONE_DIR"
"$PARA_RUN_HOOK" git:before
if [ -e "$dest/.git" ]; then
  :
elif [ -e "$dest" ]; then
  die "$dest exists but is not a Git checkout. Move it aside, then re-run: para up $PARA_NAME"
else
  if ! clone; then
    ssh_origin \
      || die "clone failed. Fix access to $PARA_ORIGIN, then re-run: para up $PARA_NAME"
    stage "Authorize this machine's para key on your Git host"
    cat ~/.ssh/id_ed25519.pub >&2
    pause "Press Enter once the key is added"
    clone \
      || die "clone still failing. Is the key authorized? Re-run: para up $PARA_NAME"
  fi
fi

cd "$dest"
if [ -f "$PARA_HOST_ENV" ]; then
  cp "$PARA_HOST_ENV" .env
  chmod 600 .env
fi
