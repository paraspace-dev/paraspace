{
  "name": "paraspace",
  "version": "0.4.1",
  "description": "ParaSpace: parallel dev workspaces on Incus",
  "keywords": [
    "incus",
    "lxc",
    "docker",
    "caddy",
    "dev-workspace",
    "parallel",
    "sandbox",
    "container",
    "cli"
  ],
  "homepage": "https://paraspace.dev",
  "bugs": "https://github.com/paraspace-dev/paraspace/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraspace-dev/paraspace.git"
  },
  "license": "MIT",
  "author": "Wes Roberts",
  "os": [
    "linux",
    "darwin"
  ],
  "scripts": {
    "lint": "bin/lint",
    "test": "test/run",
    "test:cli": "test/run --cli",
    "test:e2e": "test/run --e2e",
    "check": "npm run lint && npm run test:cli",
    "site": "vitepress dev",
    "site:build": "vitepress build",
    "site:preview": "vitepress preview",
    "release": "bin/release",
    "preversion": "npm run check",
    "prepublishOnly": "npm run check",
    "prune-branches": "bin/prune-branches"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "bin": {
    "para": "bin/para"
  },
  "files": [
    "bin/para",
    "libexec",
    "README.md",
    "LICENSE",
    "docs",
    "layers"
  ],
  "publishConfig": {
    "access": "public"
  }
}
