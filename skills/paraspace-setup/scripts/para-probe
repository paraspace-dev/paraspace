#!/usr/bin/env bash
set -u
# para-probe writes one read-only report on this machine and this project, so a
# ParaSpace setup starts from what is installed rather than from a guess.
#
# Neither -e nor pipefail: every section is allowed to fail (a missing tool IS
# the finding), and a non-zero exit would read as "the survey broke", sending
# the agent off to debug the probe instead of the machine.

have()    { command -v "$1" >/dev/null 2>&1; }
section() { printf '\n== %s\n' "$*"; }
kv()      { printf '  %-14s %s\n' "$1" "$2"; }

# para's package root, through any symlink chain, the way bin/para's pkg_root
# does it with plain readlink, because macOS has no readlink -f. The docs and
# templates the setup skill must read live in there.
para_pkg() {
  local self dir link
  self="$(command -v para)" || return 1
  while [ -L "$self" ]; do
    dir="$(cd -P "$(dirname "$self")" && pwd)"
    link="$(readlink "$self")"
    case "$link" in /*) self="$link" ;; *) self="$dir/$link" ;; esac
  done
  cd -P "$(dirname "$self")/.." && pwd
}

# para finds a project by walking up from $PWD for a .paraspace/, so git's
# toplevel is only a fallback. In a monorepo the two are different directories.
project_root() {
  local dir="$PWD"
  while [ "$dir" != / ]; do
    if [ -d "$dir/.paraspace" ]; then printf '%s\n' "$dir"; return; fi
    dir="$(dirname "$dir")"
  done
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

# Ask git rather than looking for a .git directory. In a linked worktree (one
# checkout per branch, para's own audience) .git is a file, and calling that
# "no VCS" sends the agent off to write a tar-seeding verb it doesn't need.
vcs_kind() {
  if   git -C "$1" rev-parse --git-dir >/dev/null 2>&1; then echo git
  elif [ -d "$1/.hg"  ]; then echo mercurial
  elif [ -d "$1/.svn" ]; then echo svn
  else echo "none found, the code has to be pushed in rather than cloned"
  fi
}

# The artifacts that decide a hook, a base image or a runtime pin, which are the
# sources references/evidence.md knows how to read. No package.json, because in a
# JS monorepo it floods the list on its own.
evidence_files() { # evidence_files <root>
  local f
  # Top-level reads first, since they answer fastest and the caller caps the list.
  find "$1" -maxdepth 1 \( -iname 'README*' -o -iname 'CONTRIBUTING*' \) -print 2>/dev/null
  for f in bin/setup bin/dev bin/bootstrap script/setup script/bootstrap; do
    if [ -f "$1/$f" ]; then printf '%s\n' "$1/$f"; fi
  done
  find "$1" -maxdepth 3 \
    \( -name node_modules -o -name .git -o -name vendor -o -name .venv \) -prune -o \
    \( -iname 'docker-compose*.y*ml' -o -iname 'compose*.y*ml' -o -iname 'Dockerfile*' \
       -o -iname 'devcontainer.json' -o -iname 'Procfile*' -o -iname '*.tf' \
       -o -iname 'mise.toml' -o -iname '.tool-versions' -o -iname '.nvmrc' \
       -o -iname '.ruby-version' -o -iname '.python-version' \
       -o -iname 'Gemfile' -o -iname 'pyproject.toml' -o -iname 'go.mod' \
       -o -iname 'flake.nix' -o -iname 'shell.nix' -o -iname 'Vagrantfile' \
       -o -iname 'playbook*.y*ml' -o -iname 'skaffold.y*ml' -o -iname 'Chart.yaml' \
       -o -iname '.env.example' -o -iname 'Makefile' -o -iname 'Taskfile.y*ml' \
       -o -iname 'provision*.sh' -o -iname 'bootstrap*.sh' -o -iname 'setup*.sh' \) \
    -print 2>/dev/null
}

section machine
kv os "$(uname -s) $(uname -r) $(uname -m)"
case "$(uname -s)" in
  Darwin)
    kv incus-runs-in "a Colima VM, which holds the containers, images and storage pool"
    if have colima; then colima list 2>&1 | sed 's/^/  /'; else kv colima "MISSING, run: brew install colima"; fi
    ;;
  Linux)
    [ -r /etc/os-release ] && kv distro "$(sed -n 's/^PRETTY_NAME=//p' /etc/os-release | tr -d '"')"
    kv incus-runs-in "the host kernel, natively"
    ;;
esac

section tools
for t in para incus caddy git docker; do
  if have "$t"; then kv "$t" "$(command -v "$t")"; else kv "$t" "MISSING"; fi
done
have incus || kv incus-install "https://linuxcontainers.org/incus/docs/main/installing/ (distro repos ship too-old versions)"
have caddy || kv caddy-install "https://caddyserver.com/docs/install"
have para  || kv para-install  "npm i -g paraspace"
have para  && kv para-version  "$(para --version 2>&1 | head -1)"
have incus && kv incus-version "$(incus version 2>&1 | tr '\n' ' ')"
have caddy && kv caddy-version "$(caddy version 2>&1 | head -1)"
if pkg="$(para_pkg 2>/dev/null)"; then
  kv docs      "$pkg/docs"        # the authoritative spec for THIS para
  kv templates "$pkg/templates"
fi

# Storage driver is the one thing doctor can only warn about, and the one that
# costs the most silently, since nested Docker on btrfs/zfs falls back to vfs.
section incus
if have incus && incus info >/dev/null 2>&1; then
  printf '  storage pools (name,driver):\n'
  incus storage list -f csv -c nD | sed 's/^/    /'
  kv note "only PARA_POOL's driver matters; 'para doctor' below names that pool"
  printf '  managed bridges (name,ipv4):\n'
  incus network list -f csv -c nm4 | grep ',YES,' | cut -d, -f1,3 | sed 's/^/    /'
else
  kv daemon "unreachable; on macOS run: colima start --runtime incus"
fi

section "para doctor"
if have para; then
  report="$(para doctor 2>&1)"; rc=$?
  printf '%s\n' "$report" | sed 's/^/  /'
  kv exit "$rc; host ✗ are the human's to fix, and 'no image' is expected before adoption"
else
  kv skipped "para is not installed"
fi

# What this repo already says about how it comes up. Every hit is a source for
# the .paraspace/ you are about to write; see references/evidence.md.
section "project evidence"
root="$(project_root)"
kv root "$root"
kv vcs "$(vcs_kind "$root")"
if [ -d "$root/.paraspace" ]; then
  kv paraspace "present, so this project is already adopted and you are AMENDING it"
  find "$root/.paraspace" -mindepth 1 -maxdepth 1 -exec basename {} \; | sed 's/^/    /'
else
  kv paraspace "absent, nothing adopted yet"
fi
printf '  files that describe provisioning:\n'
# An empty labelled list reads as "the find broke", so say it found nothing.
evidence="$(evidence_files "$root" | sed "s|^$root/|    |" | head -40)"
if [ -n "$evidence" ]; then printf '%s\n' "$evidence"; else printf '    (none)\n'; fi
if [ -d "$root/.github/workflows" ]; then
  printf '  ci:\n'
  find "$root/.github/workflows" -mindepth 1 -maxdepth 1 | sed "s|^$root/|    |" | head -20
fi
