# .paraspace/Parafile — per-project config for para. Sourced as bash: it sets the
# few PARA_* variables para itself reads (version, image, what to clone, routes).
# Everything else is a hook (.paraspace/hooks/). A real env var overrides any of these.
#
# Active below: only the keys a project actually has to decide. Everything para
# defaults sensibly is listed commented-out at the bottom — so you can see what's
# available without this file carrying a stale copy of para's own defaults.
#
# Full schema: the ParaSpace docs — docs/parafile.md in the package.

# para contract version these hooks target. para refuses (clearly) on a mismatch.
: "${PARA_VERSION:=1}"

# Project identity — the single key para uses for ownership, `para ls` scoping, and
# the shared-volume name (para-home-<PARA_PROJECT>). Independent of where this dir
# lives on disk, so moving/renaming the checkout keeps its workspaces bound to it.
# A plain slug ([a-z0-9-]). (`para init` sets this to your project's directory name.)
: "${PARA_PROJECT:=void-docker-gh}"

# What `para image build` builds FROM: the incus image its builder launches, and
# one `sh -c` line run inside it before .paraspace/image-build.sh. NEITHER has a
# default — para never picks your distro, and a para update must not be able to
# change it under you. Any incus image works (`images:debian/13`,
# `images:alpine/edge`, …); this template targets Void. The bootstrap must leave
# BASH in the builder (para runs image-build.sh with `bash -s`); here it also
# refreshes Void's bundled xbps, a rolling-release snapshot that can be too stale
# to install against. Set it to "" if your base needs nothing.
: "${PARA_BASE_IMAGE:=images:voidlinux}"
: "${PARA_IMAGE_BOOTSTRAP:=xbps-install -Syu xbps bash}"

# Git URL para clones into each workspace. Change it to your project's repo.
: "${PARA_ORIGIN:=git@github.com:jchook/docker-caddy.git}"

# HTTP routes para publishes through its Caddy — one TLS site per "[sub:]port".
# A bare port is the workspace apex; sub:port adds a subdomain (left is where
# you arrive, right is where it goes, as in `docker -p`):
#   8080            -> https://<name>.$PARA_DOMAIN
#   3000,api:3001   -> apex :3000 plus https://api.<name>.$PARA_DOMAIN -> :3001
# Separate entries with commas, spaces, tabs or newlines — para normalizes them — so
# a project with several routes can lay them out to be read:
#   PARA_ROUTES="
#     3000
#     api:3001
#     db:8081
#   "
# Required — para pins no default port. For a workspace with no HTTP at all
# (a worker, a queue consumer), declare it empty: PARA_ROUTES=""
PARA_ROUTES="${PARA_ROUTES-8080}"

# ---- optional -----------------------------------------------------------------
# para's own defaults, spelled out so you don't have to go look them up. Uncomment
# only what you actually want to change.

# Image `para up` launches, published by `para image build`. Defaults to
# $PARA_PROJECT — set it only to point several projects at one shared image.
# : "${PARA_IMAGE:=$PARA_PROJECT}"

# Wildcard domain the workspaces live under: https://<name>.$PARA_DOMAIN. Its
# wildcard must resolve to 127.0.0.1 — the default, paraspace.dev, already does.
# : "${PARA_DOMAIN:=paraspace.dev}"

# Directory under ~ to clone into. Default: app
# : "${PARA_CLONE_DIR:=docker-caddy}"

# Shared-volume name — one authenticated home per project by default. Pin several
# projects to a single name to share dotfiles and auth across them.
# : "${PARA_VOLUME:=para-home-$PARA_PROJECT}"

# If your repository is private, enable this: gh authorizes this machine's para
# key for you. Otherwise para prints the key and waits for you to add it by hand.
# : "${PARA_GH_AUTH:=1}"

# para copies the project's own .env into each clone if it has one. Point this at
# a different base .env to seed instead, or set it empty to seed nothing.
# : "${PARA_HOST_ENV:=$PROJECT_ROOT/.env}"
