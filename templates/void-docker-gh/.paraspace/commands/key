#!/usr/bin/env bash
# summary: print this machine's para ssh key, to authorize on your git host
set -euo pipefail
# The key lives on the shared volume, which every workspace of this project
# mounts, so any running one is a door to it. The path is this template's
# choice (its provision hook created the key), which is exactly why this is a
# project command and not an engine verb.
# A RUNNING one: `para sh` refuses a stopped workspace, and `ls --names`
# happily lists those too.
ws="${1:-$("$PARA_BIN" ls | awk '$2 == "RUNNING" { print $1; exit }')}"
[ -n "$ws" ] || { echo "no workspace to read the key from. Run 'para up <name>' first" >&2; exit 1; }

exec "$PARA_BIN" sh "$ws" -c "cat $PARA_SHARED/ssh/id_ed25519.pub"
