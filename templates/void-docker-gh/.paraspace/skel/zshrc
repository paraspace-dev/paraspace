# para shared zshrc, seeded once into the shared volume from .paraspace/skel/, then
# yours (para never overwrites it after the first seed). Shared by every workspace
# of this project via ~/.zshrc, so edits apply everywhere. Keep it small; grow it.

# --- history (per-workspace: home is not shared) -----------------------------
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt append_history share_history hist_ignore_all_dups hist_reduce_blanks

# --- shell niceties ----------------------------------------------------------
setopt autocd interactive_comments
autoload -Uz compinit && compinit -u

# --- prompt ------------------------------------------------------------------
# %m is the container hostname (para-<workspace>), so every shell announces which
# workspace you're in, the whole point of running several at once.
autoload -Uz vcs_info
zstyle ':vcs_info:git:*' formats ' (%b)'
precmd() { vcs_info }
setopt prompt_subst
PROMPT='%F{cyan}%m%f %F{yellow}%1~%f%F{green}${vcs_info_msg_0_}%f %# '

# --- aliases -----------------------------------------------------------------
alias d=docker
alias dc="docker compose"
alias g=git gs='git status' gd='git diff' gp='git push'
alias ..='cd ..' ...='cd ../..'
alias grep='grep --color'

# --- cd into the clone on login ----------------------------------------------
# para records this workspace's clone dir here (per-workspace); read it so the
# dotfiles reach the clone without hardcoding a repo name.
export PATH="$HOME/.local/bin:$PATH"
_clone="$(cat "$HOME/.config/para/clone-dir" 2>/dev/null || true)"
[ -n "$_clone" ] && [ -d "$HOME/$_clone" ] && cd "$HOME/$_clone"
