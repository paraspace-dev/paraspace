#!/usr/bin/env bash
# summary: run Claude Code in the workspace clone
set -euo pipefail
# `para sh` owns the terminal handling — a pty only when both ends are
# terminals, su --pty so SIGWINCH reaches the child, and a TERM the container
# has terminfo for — so a command like this stays a one-liner.
[ "$#" -ge 1 ] || { echo "usage: para claude <workspace> [claude args…]" >&2; exit 1; }
ws="$1"; shift

# Everything after the workspace passes through to claude, and `printf %q` is
# what makes that true: the command crosses into the container as ONE string
# and a shell there re-parses it, so a bare "$*" would turn
# `-p 'write a test'` into four arguments and evaluate any $ or backtick.
args=""
[ "$#" -eq 0 ] || args="$(printf '%q ' "$@")"

# --name labels the session, which Claude Code puts in the terminal title, so a
# full-screen claude stays identifiable as this workspace.
exec "$PARA_BIN" sh "$ws" -c "exec claude --name $(printf '%q' "$ws") $args"
