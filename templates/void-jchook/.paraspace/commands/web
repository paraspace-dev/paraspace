#!/usr/bin/env bash
# summary: open a workspace in the browser
set -euo pipefail
# A project command: para runs it on the HOST with every PARA_* exported, so
# opening a URL is the project's business, not the engine's. `para ls` prints
# the same URL if you would rather copy it.
[ "$#" -eq 1 ] || { echo "usage: para web <workspace>" >&2; exit 1; }

url="https://$1.$PARA_DOMAIN"
[ "$PARA_HTTPS_PORT" = 443 ] || url="$url:$PARA_HTTPS_PORT"

case "$(uname -s)" in
  Darwin) open "$url" ;;
  Linux)  xdg-open "$url" >/dev/null 2>&1 || echo "$url" ;;
  *)      echo "$url" ;;
esac
