#!/usr/bin/env bash
set -euo pipefail
# para provision hook — runs INSIDE the workspace before boot (in the clone if it
# already exists, else $HOME — so use absolute paths).
#
# Like void-docker-gh's provision, but it seeds a FULL personal dev environment
# onto the shared volume — zsh, tmux, Neovim (config only; plugins/LSPs install
# once at first launch), Claude Code config, a git identity with handy aliases, an
# ssh key, and a $BROWSER helper — so every workspace of this project shares one
# authenticated, configured home. Then it clones and copies the project's .env.
#
# This is yours to grow. It's idempotent: para re-runs it on every `para up`.
# Full hook contract: the paraspace README.

. "$(dirname "$0")/helpers"

skel="$HOME/.paraspace/skel"
shared="$PARA_SHARED"

# ---- 1. seed the shared volume (once) --------------------------------------
# Whatever lives here is shared by every workspace of this project, so you
# configure + authenticate once. The dotfiles are yours after the first seed —
# para never overwrites them.
if [ ! -f "$shared/.seeded" ]; then
  stage "Seeding shared volume (one-time)"
  mkdir -p "$shared"
  cp "$skel/zshrc"     "$shared/zshrc"
  cp -R "$skel/tmux"   "$shared/tmux"
  cp -R "$skel/claude" "$shared/claude"
  chmod +x "$shared/claude/statusline.sh" 2>/dev/null || true
  test -f "$shared/claude.json" || echo '{}' > "$shared/claude.json"
  # [alias] backs the gu/gg/ggg zsh aliases (git has no built-in unstage/graph).
  printf '[user]\n\tname = %s\n\temail = %s\n[init]\n\tdefaultBranch = main\n[alias]\n\tunstage = reset HEAD --\n\tgraph = log --graph --abbrev-commit --decorate --oneline\n\tgraphgpg = log --graph --abbrev-commit --decorate --oneline --show-signature\n' \
    "${PARA_GIT_NAME:-}" "${PARA_GIT_EMAIL:-}" > "$shared/gitconfig"
  # Per-machine ssh key for git push; authorize once on your git host. Never the host's.
  mkdir -p "$shared/ssh" && chmod 700 "$shared/ssh"
  test -f "$shared/ssh/id_ed25519" \
    || ssh-keygen -t ed25519 -N "" -C "para-${PARA_HOSTNAME:-$(hostname)}" -f "$shared/ssh/id_ed25519" >/dev/null
  touch "$shared/.seeded"
fi

# nvim config + $BROWSER helper: self-guarding so an older shared volume gets them
# too. nvim-data (plugins/parsers/LSPs) is created empty and populated once, at
# first `nvim` launch, then reused by every workspace.
[ -e "$shared/nvim" ] || cp -R "$skel/nvim" "$shared/nvim"
mkdir -p "$shared/nvim-data"
if [ ! -x "$shared/bin/open-url" ]; then
  mkdir -p "$shared/bin"; cp "$skel/bin/open-url" "$shared/bin/open-url"; chmod +x "$shared/bin/open-url"
fi

# ---- 2. link the shared surface into $HOME ---------------------------------
# Everything symlinked here lives on the shared volume (configure once, consistent
# everywhere); everything else is per-workspace. bun-cache/gh are created (not
# symlinked) — only tools that write into them use them.
mkdir -p "$shared/gh" ~/.config ~/.config/para ~/.local/share ~/.ssh && chmod 700 ~/.ssh
ln -sfn "$shared/zshrc"              ~/.zshrc
ln -sfn "$shared/tmux"               ~/.config/tmux
ln -sfn "$shared/gh"                 ~/.config/gh
ln -sfn "$shared/nvim"               ~/.config/nvim
ln -sfn "$shared/nvim-data"          ~/.local/share/nvim
ln -sfn "$shared/claude"             ~/.claude
ln -sfn "$shared/claude.json"        ~/.claude.json
ln -sfn "$shared/gitconfig"          ~/.gitconfig
ln -sfn "$shared/ssh/id_ed25519"     ~/.ssh/id_ed25519
ln -sfn "$shared/ssh/id_ed25519.pub" ~/.ssh/id_ed25519.pub
# Record the clone dir so the shared zshrc can cd in without hardcoding a name.
echo "$PARA_CLONE_DIR" > ~/.config/para/clone-dir
grep -q github.com ~/.ssh/known_hosts 2>/dev/null \
  || ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null || true
if command -v zsh >/dev/null 2>&1 && [ "$SHELL" != "$(command -v zsh)" ]; then
  sudo chsh -s "$(command -v zsh)" "$PARA_USER" 2>/dev/null || true
fi

# ---- 3. Claude managed policy (container-local, root-owned) ----------------
# Highest-precedence managed layer so a theme/UI change can't clobber defaultMode.
if sudo mkdir -p /etc/claude-code 2>/dev/null; then
  printf '%s\n' '{ "permissions": { "defaultMode": "acceptEdits" }, "includeCoAuthoredBy": false }' \
    | sudo tee /etc/claude-code/managed-settings.json >/dev/null
else
  warn "couldn't write Claude managed policy (no passwordless sudo?)"
fi

# ---- 4. clone the repo (+ key authorization on first use) ------------------
export BROWSER="$shared/bin/open-url"
[ -n "${PARA_ORIGIN:-}" ] || die "set PARA_ORIGIN in .paraspace/Parafile to your repo's git URL"

clone() {
  [ -d "$HOME/$PARA_CLONE_DIR/.git" ] && return 0
  local branch=(); [ -n "${PARA_CLONE_BRANCH:-}" ] && branch=(--branch "$PARA_CLONE_BRANCH")
  git clone "${branch[@]}" "$PARA_ORIGIN" "$HOME/$PARA_CLONE_DIR"
}

# Authorize this machine's para key on the git host. With PARA_GH_AUTH set, let
# `gh` upload it; otherwise (or if gh doesn't pan out) print it and wait for you to
# add it by hand. Any gh hiccup falls through to the manual path rather than aborting.
authorize_key() {
  if [ -n "${PARA_GH_AUTH:-}" ] && command -v gh >/dev/null 2>&1; then
    stage "Authorizing this machine's para key via gh"
    infocmp "${TERM:-}" >/dev/null 2>&1 || export TERM=xterm-256color
    if gh auth status --hostname github.com >/dev/null 2>&1 \
       || { interactive && gh auth login --hostname github.com --git-protocol ssh --skip-ssh-key --scopes admin:public_key; }; then
      gh ssh-key add ~/.ssh/id_ed25519.pub \
        --title "para $(basename "${PARA_ORIGIN%.git}") (${PARA_HOSTNAME:-$(hostname)})" || true
      return 0
    fi
    warn "gh auth didn't complete — falling back to manual key authorization."
  fi
  stage "Authorize this machine's para key on your git host (e.g. github.com/settings/keys):"
  cat ~/.ssh/id_ed25519.pub >&2
  pause "Press Enter once the key is added"
}

if ! clone; then
  authorize_key
  clone || die "clone still failing — is the key authorized on the git host? Re-run: para up $PARA_NAME"
fi

# ---- 5. .env ---------------------------------------------------------------
# para seeds the project's own .env (if it has one) to ~/.paraspace/host.env; copy it
# into the clone. Nothing there means nothing to do.
cd "$HOME/$PARA_CLONE_DIR"
if [ -f "$HOME/.paraspace/host.env" ]; then
  cp "$HOME/.paraspace/host.env" .env
  chmod 600 .env
fi
