# para shared zshrc — seeded once into the para-home volume from .paraspace/skel/,
# then yours to mutate (para never overwrites it after the first seed).
# This single file is shared by EVERY workspace via ~/.zshrc -> /para/shared/zshrc,
# so edits here apply everywhere immediately. Keep it portable.

# --- history -----------------------------------------------------------------
HISTFILE=~/.zsh_history          # per-workspace (home is NOT shared)
HISTSIZE=100000
SAVEHIST=100000
setopt append_history share_history hist_ignore_all_dups hist_reduce_blanks

# --- shell niceties ----------------------------------------------------------
setopt autocd interactive_comments
autoload -Uz compinit && compinit -u
autoload -Uz colors && colors

# --- fzf: fuzzy completion + key bindings (CTRL-T, CTRL-R, ALT-C) ------------
# `fzf --zsh` emits both; source it after compinit so completion hooks in.
command -v fzf >/dev/null && source <(fzf --zsh)

# --- prompt ------------------------------------------------------------------
# %m is the container hostname (para-<workspace>), so every shell announces
# which workspace you're in — the whole point of running several at once.
autoload -Uz vcs_info
zstyle ':vcs_info:git:*' formats ' (%b)'
precmd() { vcs_info }
setopt prompt_subst
PROMPT='%F{cyan}%m%f %F{yellow}%1~%f%F{green}${vcs_info_msg_0_}%f %# '

# --- PATH --------------------------------------------------------------------
# bun installs here; keep ~/.local/bin and the clone's bin on PATH too.
export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"
# para records this workspace's clone dir here (per-workspace); the shared
# dotfiles read it so they reach the clone without hardcoding a repo name.
_para_clone="$(cat "$HOME/.config/para/clone-dir" 2>/dev/null || true)"
[ -n "$_para_clone" ] && [ -d "$HOME/$_para_clone/bin" ] && export PATH="$HOME/$_para_clone/bin:$PATH"

# --- editor ------------------------------------------------------------------
# The base image installs neovim; fall back to vim if it's ever missing.
if command -v nvim >/dev/null; then
  export EDITOR=${EDITOR:-nvim}
  alias vim='nvim' vi='nvim'
else
  export EDITOR=${EDITOR:-vim}
fi

# --- browser -----------------------------------------------------------------
# No browser inside the container: point $BROWSER at a helper (seeded by this
# template's hooks/provision
# onto the shared volume) so tools that try to "open" a URL (notably
# `gh auth login`'s device flow, `gh ... --web`) succeed and print the URL with
# guidance instead of erroring with "xdg-open … not found in $PATH". Open the URL
# it prints on your own machine.
export BROWSER=${BROWSER:-/para/shared/bin/open-url}

# --- aliases -----------------------------------------------------------------
# quicker
alias b=bun
alias d=docker
alias dc="docker compose"
alias dcp="docker compose -f docker-compose.prod.yml"
alias dr="docker run -it --rm"
alias fdi="fd -i"
alias j=just
alias rgi="rg -i"
alias t=tmux
alias ta='tmux attach'

# ls -> lsd (baked into the base image). Keeps l/ll/la muscle memory.
alias ls='lsd'
alias l='lsd -l'
alias la='lsd -a'
alias ll='lsd -la'

# cd up N levels
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'
alias .......='cd ../../../../../..'

# git — `gu`/`gg`/`ggg` map to git aliases seeded in the gitconfig this
# template's hooks/provision writes
alias g='git'
alias ga='git add'
alias gc='git commit'
alias gs='git status'
alias gsw='git switch'
alias gd='git diff'
alias gdh='git diff HEAD^..HEAD'
alias gf='git fetch'
alias gm='git merge'
alias gr='git rebase'
alias grc='git rebase --continue'
alias gp='git push'
alias gu='git unstage'
alias gg='git graph'
alias ggg='git graphgpg'
alias gco='git checkout'
alias gcs='git commit -S'
alias grhh='git reset --hard HEAD'

# handy defaults
alias grep="grep --color"
alias ip="ip -brief -color"
alias mkdir="mkdir -p"
alias tree='tree -CAFa -I ".expo|.svn|.git|.hg|node_modules|.terraform" --dirsfirst'

# xbps
alias sv="sudo sv"
alias vsv="sudo vsv"
alias xxa="xbps-alternatives"
alias xxi="sudo xbps-install"
alias xxq="xbps-query"
alias xxrm="sudo xbps-remove"

# Jump into the clone on login (dir recorded by para in ~/.config/para/clone-dir).
[ -n "${_para_clone:-}" ] && [ -d "$HOME/$_para_clone" ] && cd "$HOME/$_para_clone"
