#!/usr/bin/env bash
set -euo pipefail
# para boot hook — runs INSIDE the workspace after provision. Its job is to bring
# the app up and, per para's readiness contract, return zero only once every
# routed service is actually listening.
#
# This bare box has no app, so there's nothing to boot: it returns 0 immediately.
# The workspace comes up and `para sh <name>` gives you a shell, but the routed
# URL (https://<name>.$PARA_DOMAIN) 502s because nothing listens on :8080 yet.
#
# When you add an app, start it here. For a docker stack that's one line — the
# `--wait` makes it honor the readiness contract by blocking until healthchecked
# services are healthy:
#
#     cd "$HOME/$PARA_CLONE_DIR"
#     docker compose up -d --wait --wait-timeout 300
#
# (templates/void-docker-gh/.paraspace/hooks/boot does exactly this.)

. "$(dirname "$0")/helpers"

stage "Bare box — nothing to boot. Add your app's start command here."
