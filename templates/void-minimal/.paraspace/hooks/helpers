#!/usr/bin/env bash
# Shared helpers for the para hooks. Sourced, not executed — each hook does:
#   . "$(dirname "$0")/helpers"
# so the hook bodies read as WHAT they do, not how they print it.

# Color, but only on a terminal — para captures hook output to logs.
if [ -t 2 ]; then
  _hd=$'\033[36;1m'; _wn=$'\033[33m'; _er=$'\033[31m'; _off=$'\033[0m'
else
  _hd='' _wn='' _er='' _off=''
fi

stage() { printf '%s==> %s%s\n'   "$_hd" "$*" "$_off" >&2; }  # section header
info()  { printf '    %s\n'        "$*"               >&2; }  # indented detail
warn()  { printf '%swarn:%s %s\n'  "$_wn" "$_off" "$*" >&2; }
die()   { printf '%serror:%s %s\n' "$_er" "$_off" "$*" >&2; exit 1; }

# Is there a human to prompt? (para sets PARA_NONINTERACTIVE in CI/cron.)
interactive() { [ -z "${PARA_NONINTERACTIVE:-}" ] && [ -t 0 ]; }

# Print a prompt and wait for Enter — only when someone can answer.
pause() { if interactive; then printf '%s ' "$*" >&2; read -r _ || true; fi; }

# The project's HTTP routes, one "[sub:]port" per line — para injects them as the
# comma-separated $PARA_ROUTES. Prints nothing when the project publishes none,
# so a `for` over it is simply a no-op.
#   for r in $(parse_routes); do …; done
parse_routes() {
  [ -n "${PARA_ROUTES:-}" ] || return 0
  printf '%s\n' "$PARA_ROUTES" | tr ',' '\n'
}

# Just the port numbers, one per line — a boot hook waiting on its own routed
# services wants these, not the subdomains.
route_ports() { parse_routes | sed 's/.*://'; }
