# para shared zshrc — seeded once into the shared volume from .paraspace/skel/, then
# yours (para never overwrites it after the first seed). Shared by every workspace
# of this project via ~/.zshrc, so edits apply everywhere.
#
# NOTE: the void-minimal base image installs NOTHING, so it logs you into bash and
# this file sits unused until you add `zsh` to .paraspace/image-build.sh — at which
# point the provision hook switches your login shell and this applies. It's the
# seed of your shell config; grow it as you add tools. (templates/void-jchook is a
# fully fleshed-out version — aliases, a git-aware prompt, editor/browser setup.)

# --- history (per-workspace: home is not shared) -----------------------------
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt append_history share_history hist_ignore_all_dups hist_reduce_blanks

# --- shell niceties ----------------------------------------------------------
setopt autocd interactive_comments
autoload -Uz compinit && compinit -u

# --- prompt ------------------------------------------------------------------
# %m is the container hostname (para-<workspace>), so every shell announces which
# workspace you're in — the whole point of running several at once.
setopt prompt_subst
PROMPT='%F{cyan}%m%f %F{yellow}%1~%f %# '

# --- PATH --------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

