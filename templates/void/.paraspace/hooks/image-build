#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
. "$PARA_HELPERS"

# The shipped base targets Void. It owns the workspace user and the zsh paths
# every unprefixed bundled mod may extend.
PARA_USER="${PARA_USER:-app}"
PARA_UID="${PARA_UID:-1000}"
PARA_GID="${PARA_GID:-1000}"

stage "Void base packages"
xbps-install -Syu xbps >/dev/null 2>&1 || true
xbps-install -Syu -y >/dev/null
pkgs="zsh kitty-terminfo alacritty-terminfo ncurses-term"
missing=""
for package in $pkgs; do
  if ! xbps-query "$package" >/dev/null 2>&1; then
    missing="${missing:+$missing }$package"
  fi
done
if [ -n "$missing" ]; then
  # shellcheck disable=SC2086  # package names are the words assembled above
  xbps-install -Sy $missing >/dev/null
fi

stage "Writable /tmp"
chmod 1777 /tmp

stage "$PARA_USER user ($PARA_UID:$PARA_GID)"
getent group "$PARA_USER" >/dev/null 2>&1 \
  || groupadd -g "$PARA_GID" "$PARA_USER"
shell="$(command -v zsh)"
if ! id -u "$PARA_USER" >/dev/null 2>&1; then
  useradd -m -u "$PARA_UID" -g "$PARA_GID" -s "$shell" "$PARA_USER"
else
  usermod -s "$shell" "$PARA_USER"
fi
printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$PARA_USER" \
  > "/etc/sudoers.d/90-$PARA_USER-nopasswd"
chmod 0440 "/etc/sudoers.d/90-$PARA_USER-nopasswd"

stage "zsh extension points"
mkdir -p /etc/zsh/zshrc.d /usr/share/zsh/site-functions
if [ ! -f /etc/zsh/zshrc ] || ! grep -q 'paraspace zshrc.d' /etc/zsh/zshrc; then
  cat >> /etc/zsh/zshrc <<'EOF'

# paraspace zshrc.d
for para_rc in /etc/zsh/zshrc.d/*.zsh(N); do
  source "$para_rc"
done
unset para_rc
EOF
fi

stage "Void base complete"
