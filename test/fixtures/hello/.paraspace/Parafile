# .paraspace/Parafile — the para e2e test fixture ("hello").
#
# This is NOT a template (it never ships in the npm package); it's the smallest
# real para project the end-to-end suite can drive: an Alpine box that serves a
# fixed sentinel over HTTP on :8080, so the tests can assert the whole path —
# `para up` -> hooks -> boot readiness -> Caddy TLS -> bridge IP -> the app.
#
# Sourced as bash. The harness (test/run) overrides PARA_PROJECT, PARA_VOLUME and
# PARA_HTTPS_PORT via the environment so a test run is sandboxed from your real
# workspaces; the defaults here just keep a by-hand `para up` in this dir working.

# Contract version these hooks target — para refuses on a mismatch.
: "${PARA_VERSION:=1}"

# Project identity (ownership, `para ls` scoping, shared-volume suffix). The
# harness overrides this with a throwaway slug per run.
: "${PARA_PROJECT:=paratest}"

# The tiny Alpine base image the suite runs on: ~5.5 MB of bash + busybox httpd +
# a $PARA_USER/$PARA_UID user. Built by `para image build` from the
# .paraspace/image-build.sh next to this file — which is half the point of the
# fixture: it's a non-Void, Docker-free consumer, so an e2e run proves
# image build carries no distro or Docker assumptions of its own.
: "${PARA_IMAGE:=alpine-minimal}"

# What image build builds FROM. Alpine ships no bash and para runs the payload
# with `bash -s`, so the bootstrap has exactly one job: put bash there.
: "${PARA_BASE_IMAGE:=images:alpine/edge}"
: "${PARA_IMAGE_BOOTSTRAP:=apk add --no-cache bash}"

# Wildcard domain; `*.paraspace.dev` already resolves to 127.0.0.1.
: "${PARA_DOMAIN:=paraspace.dev}"

# The dir under ~ that `para sh -c` cd's into. No repo is cloned here, so the
# provision hook just `mkdir`s it — see hooks/provision.
: "${PARA_CLONE_DIR:=app}"

# One route: the workspace apex -> the busybox httpd the boot hook starts on :8080.
#   https://<name>.paraspace.dev  ->  <container-ip>:8080
#
# Deliberately written in the MULTI-LINE spelling even though it's a single route:
# para accepts comma-, space-, tab- or newline-separated entries and canonicalizes
# them to one comma-separated form, and test_routes_reach_the_provision_hook reads
# back what the hook actually received ("8080") — so this spelling is what proves
# the normalization end to end, through the hook forwarder.
PARA_ROUTES="
  8080
"
