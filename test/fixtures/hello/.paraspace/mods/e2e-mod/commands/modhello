#!/usr/bin/env bash
# summary: prove a mod's own verb reaches the host with its own directory
set -euo pipefail
# A mod's commands/ run on the HOST, not in the workspace, so this file is the
# other half of the mod contract from hooks/. $PARA_MOD_DIR is the only way it
# can find its own files: $PARA_HOOKS and $PARA_SKEL name guest paths and para
# keeps them unset out here.
[ "$#" -ge 1 ] || { echo "usage: para modhello <workspace>" >&2; exit 1; }

printf 'mod-command-ok dir=%s skel=%s\n' "${PARA_MOD_DIR-unset}" "${PARA_SKEL-unset}"

# And it composes with the engine the way a real one does.
exec "$PARA_BIN" sh "$1" -c 'echo mod-command-reached-the-guest'
