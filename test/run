#!/usr/bin/env bash
set -euo pipefail
# ============================================================================
# test/run — the para test suite.
#
# Two tiers:
#   cli   — no incus. Argument handling, `para init`, help. Fast; CI-safe.
#   e2e   — the real thing: builds a ~5.5 MB Alpine image, `para up`s a workspace,
#           and asserts the whole path (hooks -> boot readiness -> Caddy TLS ->
#           bridge IP -> the app) through actual para commands. Needs incus.
#
# Every run is sandboxed (throwaway XDG dirs + a non-default Caddy port), so it
# never touches your real para workspaces, and para allocates container IPs from
# what incus reports as actually free. Teardown removes everything it created.
#
#   Usage: test/run [--cli|--e2e|--all] [--keep] [--no-build] [--failfast] [FILTER]
#     --all       both tiers (default); e2e is skipped with a note if incus is absent
#     --cli       CLI tier only
#     --e2e       e2e tier only (errors if incus is unreachable)
#     --keep      leave workspaces + the temp XDG tree for inspection
#     --no-build  reuse the existing alpine-minimal image (skip the image build)
#     --failfast  stop at the first failing test
#     FILTER      run only tests whose description contains this substring
# ============================================================================

HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
# Overridable, so an engine under development can be driven by the same suite:
#   PARA=/path/to/para test/run --e2e
: "${PARA:=$REPO/bin/para}"
export PARA
export FIXTURE_DIR="$HERE/fixtures/hello"

tier=all
filter=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --all)      tier=all; shift ;;
    --cli)      tier=cli; shift ;;
    --e2e)      tier=e2e; shift ;;
    --keep)     export PARA_TEST_KEEP=1; shift ;;
    --no-build) export PARA_TEST_NO_BUILD=1; shift ;;
    --failfast) export PARA_TEST_FAILFAST=1; shift ;;
    # Print the header block between the two `# ====` banner rules, rather than a
    # fixed line range — `sed -n '4,25p'` silently printed the wrong thing the
    # moment anyone added a line to the header.
    -h|--help)  awk '/^# ={10,}$/{n++; next} n==1{sub(/^# ?/, ""); print} n>1{exit}' "$0"; exit 0 ;;
    -*)         echo "unknown flag: $1" >&2; exit 2 ;;
    *)          filter="$1"; shift ;;
  esac
done

# shellcheck source=lib/harness.sh
. "$HERE/lib/harness.sh"
# shellcheck source=lib/assert.sh
. "$HERE/lib/assert.sh"
# shellcheck source=lib/sandbox.sh
. "$HERE/lib/sandbox.sh"
# shellcheck source=lib/project.sh
. "$HERE/lib/project.sh"

incus_ok=0
if command -v incus >/dev/null 2>&1 && incus info >/dev/null 2>&1; then incus_ok=1; fi

run_e2e=0
case "$tier" in
  cli) ;;
  e2e) [ "$incus_ok" -eq 1 ] || { echo "e2e tier needs a reachable incus daemon." >&2; exit 1; }; run_e2e=1 ;;
  all) if [ "$incus_ok" -eq 1 ]; then run_e2e=1; else echo "${_t_gray:-}note: incus unreachable — running CLI tier only.${_t_off:-}" >&2; fi ;;
esac

# Arm teardown BEFORE any setup that can fail (sandbox_base creates the temp XDG
# tree on its first line; the image build can fail after that).
# sandbox_teardown is defensive — empty workspace list, unset volume, absent Caddy
# are all no-ops — so it's safe for the CLI tier too.
trap sandbox_teardown EXIT
# EXIT alone is not enough: bash does NOT run an EXIT trap when the shell dies on
# an UNtrapped fatal signal, and Ctrl-C during an e2e run is the likeliest abort
# there is — it would leak the run's workspaces, volume, Caddy and temp tree.
# Trapping INT/TERM to an explicit `exit` puts us back on the normal exit path,
# which then fires the EXIT trap above. Same shape as bin/para's image build.
trap 'echo >&2; echo "interrupted — tearing down…" >&2; exit 130' INT TERM

if [ "$run_e2e" -eq 1 ]; then
  sandbox_e2e
  # Three fixed, pre-tracked workspace names so teardown reclaims them even if a
  # test aborts (tests run in subshells and can't grow the parent's tracking list).
  export PARA_WS="para${$}a" PARA_WS2="para${$}b" PARA_WS3="para${$}c"
  sandbox_track "$PARA_WS"; sandbox_track "$PARA_WS2"; sandbox_track "$PARA_WS3"
  # The one expensive shared boot: bring the primary workspace up once. Read-only
  # tests assert against it; if this fails the whole e2e tier is moot, so surface
  # the log and stop.
  echo "${_t_gray:-}==> provisioning shared workspace $PARA_WS (first boot)…${_t_off:-}" >&2
  if ! "$PARA" up "$PARA_WS"; then
    echo "FATAL: 'para up $PARA_WS' failed — see output above." >&2
    exit 1
  fi
else
  sandbox_base
fi

# Source the selected tiers' test files (each defines test_* functions). The
# paths are runtime globs, so shellcheck can't follow them — that's expected.
shopt -s nullglob
# shellcheck disable=SC1090
[ "$tier" != e2e ] && for f in "$HERE"/cli/*.sh; do . "$f"; done
# shellcheck disable=SC1090
[ "$run_e2e" -eq 1 ] && for f in "$HERE"/e2e/*.sh; do . "$f"; done
shopt -u nullglob

run_all "$filter"
